<% content_for :title, "Comarcas" %>

<section class="case-section">
  <div class="section-head">
    <h3>Comarcas</h3>
    <%= link_to "Nova comarca", new_district_path, class: "btn btn-secondary" %>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @districts.each do |district| %>
          <tr>
            <td><%= district.name %></td>
            <td>
              <%= link_to "Editar", edit_district_path(district) %>
              <%= button_to "Excluir", district, method: :delete, form: { data: { turbo_confirm: "Excluir esta comarca?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
