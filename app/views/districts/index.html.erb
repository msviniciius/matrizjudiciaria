<% content_for :title, "Comarcas" %>

<% content_for :topbar_actions do %>
  <%= link_to "Nova comarca", new_district_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @districts.any? %>
          <% @districts.each do |district| %>
            <tr>
              <td><%= district.name %></td>
              <td>
                <div class="table-actions">
                  <%= link_to "Editar", edit_district_path(district), class: "btn btn-secondary" %>
                  <%= button_to "Excluir", district, method: :delete, class: "btn btn-danger", form: { class: "table-action-form", data: { turbo_confirm: "Excluir esta comarca?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="2" class="table-empty-state">Nenhuma comarca cadastrada.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
