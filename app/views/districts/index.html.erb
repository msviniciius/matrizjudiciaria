<% content_for :title, "Comarcas" %>

<% content_for :topbar_actions do %>
  <%= link_to "Nova comarca", new_district_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th class="actions-col">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @districts.any? %>
          <% @districts.each do |district| %>
            <tr>
              <td><%= district.name %></td>
              <td class="table-actions">
                <%= link_to edit_district_path(district), class: "btn btn-secondary btn-icon", aria: { label: "Editar comarca" }, title: "Editar comarca" do %>
                  <span aria-hidden="true">&#9998;</span>
                <% end %>
                <%= button_to district, method: :delete, class: "btn btn-danger btn-icon", form: { class: "table-action-form", data: { turbo_confirm: "Excluir esta comarca?" } }, aria: { label: "Excluir comarca" }, title: "Excluir comarca" do %>
                  <span aria-hidden="true">&#128465;</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="2" class="table-empty-state">Nenhuma comarca cadastrada.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
