<% back_path = local_assigns[:back_path] %>
<% show_path = local_assigns[:show_path] %>
<% show_label = local_assigns[:show_label] || "Ver" %>

<%= form_with(model: deadline, class: "app-form aurora-form", data: { inline_validation_form: true }) do |form| %>
  <% if deadline.errors.any? %>
    <div class="form-errors aurora-form__errors">
      <h2>Foram encontrados <%= pluralize(deadline.errors.count, "erro", "erros") %> neste cadastro:</h2>
      <ul>
        <% deadline.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="form-section aurora-form__section">
    <div class="dashboard-section__head">
      <h3>Dados do prazo</h3>
      <p>Associe o prazo ao processo e defina sua classificação operacional.</p>
    </div>
    <p class="form-hint">Os campos com <strong>*</strong> são obrigatórios.</p>
    <div class="form-grid">
      <div class="field-full">
        <%= form.label :legal_case_id, "Processo *" %>
        <%= form.collection_select :legal_case_id, current_office.legal_cases.includes(:client).order(:internal_number), :id, :display_number_and_client, { prompt: "Selecione o processo" }, { required: true, data: { required_field: true } } %>
        <p class="field-inline-warning" data-field-error-for="deadline_legal_case_id" hidden>Selecione o processo.</p>
      </div>

      <div>
        <%= form.label :title, "Título *" %>
        <%= form.text_field :title, required: true, data: { required_field: true } %>
        <p class="field-inline-warning" data-field-error-for="deadline_title" hidden>Informe o título do prazo.</p>
      </div>

      <div>
        <%= form.label :deadline_type, "Tipo de prazo (opcional)" %>
        <%= form.select :deadline_type, enum_options_for(Deadline, :deadline_type), include_blank: true %>
      </div>

      <div>
        <%= form.label :status, "Status *" %>
        <%= form.select :status, enum_options_for(Deadline, :status), {}, { required: true, data: { required_field: true } } %>
        <p class="field-inline-warning" data-field-error-for="deadline_status" hidden>Selecione o status.</p>
      </div>

      <div>
        <%= form.label :priority, "Prioridade (opcional)" %>
        <%= form.select :priority, enum_options_for(Deadline, :priority), include_blank: true %>
      </div>
    </div>
  </section>

  <section class="form-section aurora-form__section">
    <div class="dashboard-section__head">
      <h3>Prazo e justificativa</h3>
      <p>Informe a data limite e o contexto necessário para acompanhamento.</p>
    </div>
    <div class="form-grid">
      <div>
        <%= form.label :due_date, "Data limite *" %>
        <%= form.date_field :due_date, required: true, data: { required_field: true } %>
        <p class="field-inline-warning" data-field-error-for="deadline_due_date" hidden>Informe a data limite.</p>
      </div>

      <div class="field-full">
        <%= form.label :delay_reason, "Justificativa (opcional)" %>
        <%= form.textarea :delay_reason %>
      </div>
    </div>
  </section>

  <div class="form-actions aurora-form__actions">
    <% if back_path.present? %>
      <%= link_to "Voltar", back_path, class: "btn btn-secondary" %>
    <% end %>
    <% if show_path.present? %>
      <%= link_to show_label, show_path, class: "btn btn-secondary" %>
    <% end %>
    <%= form.submit deadline.persisted? ? "Salvar prazo" : "Cadastrar prazo", class: "btn btn-primary" %>
  </div>
<% end %>
