<section class="case-section">
  <h3>Detalhes do prazo</h3>
  <div class="table-wrap details-table">
    <table>
      <tbody>
        <tr><th>Processo</th><td><%= @deadline.legal_case&.internal_number || "-" %></td></tr>
        <tr><th>Título</th><td><%= @deadline.title %></td></tr>
        <tr><th>Tipo</th><td><%= @deadline.deadline_type.present? ? enum_label(Deadline, :deadline_type, @deadline.deadline_type) : "-" %></td></tr>
        <tr><th>Data inicial</th><td><%= @deadline.start_date.present? ? l(@deadline.start_date, format: :short) : "-" %></td></tr>
        <tr><th>Data limite</th><td><%= @deadline.due_date.present? ? l(@deadline.due_date, format: :short) : "-" %></td></tr>
        <tr><th>Status</th><td><%= enum_label(Deadline, :status, @deadline.status) %></td></tr>
        <tr><th>Prioridade</th><td><%= @deadline.priority.present? ? enum_label(Deadline, :priority, @deadline.priority) : "-" %></td></tr>
        <tr><th>Concluído em</th><td><%= @deadline.completed_at.present? ? l(@deadline.completed_at, format: :short) : "-" %></td></tr>
        <tr><th>Responsável</th><td><%= @deadline.responsible_name.presence || "-" %></td></tr>
        <tr><th>Justificativa</th><td><%= @deadline.delay_reason.presence || "-" %></td></tr>
      </tbody>
    </table>
  </div>
</section>

<div class="case-actions case-actions--footer">
  <% if @deadline.expediente.present? && @deadline.expediente.ciencia.blank? %>
    <%= form_with url: ciencias_path, method: :post, local: true, class: "inline-form" do |form| %>
      <%= hidden_field_tag "ciencia[expediente_id]", @deadline.expediente.id %>
      <%= hidden_field_tag "ciencia[tipo]", "expressa" %>
      <%= form.date_field :data_ciencia, name: "ciencia[data_ciencia]", value: Date.current, required: true %>
      <%= form.submit "Registrar ciência expressa", class: "btn btn-primary" %>
    <% end %>
  <% end %>
  <% unless @deadline.status_completed? %>
    <%= form_with url: cumprir_deadline_path(@deadline), method: :patch, local: true, class: "inline-form" do |form| %>
      <%= form.text_field :protocolo_ref, name: "protocolo_ref", placeholder: "Protocolo (opcional)" %>
      <%= form.submit "Cumprir prazo", class: "btn btn-primary" %>
    <% end %>
  <% end %>
  <%= link_to "Editar prazo", edit_deadline_path(@deadline), class: "btn btn-secondary" %>
  <%= link_to "Voltar", deadlines_path, class: "btn btn-secondary" %>
  <%= button_to "Excluir prazo", @deadline, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Tem certeza que deseja excluir este prazo?" } } %>
</div>
