<% content_for :title, "Prazos" %>

<section class="case-section case-section--filters">
  <%= form_with url: deadlines_path, method: :get, local: true, class: "main-filters", data: { main_filters: true, filters_open: @advanced_filters_open } do |form| %>
    <div class="main-filters__bar">
      <button
        type="button"
        class="main-filters__toggle"
        data-main-filters-toggle
        aria-expanded="<%= @advanced_filters_open ? 'true' : 'false' %>"
      >
        <span aria-hidden="true"><%= @advanced_filters_open ? "▾" : "▸" %></span>
        Filtrar
      </button>

      <%= form.text_field :q, value: @filters[:q], placeholder: "Processo, título ou responsável", class: "main-filters__q" %>

      <%= form.submit "Buscar", class: "main-filters__submit" %>
    </div>

    <div class="main-filters__advanced <%= "is-open" if @advanced_filters_open %>" data-main-filters-advanced>
      <div class="form-grid">
        <div>
          <%= form.label :status, "Status" %>
          <%= form.select :status, enum_options_for(Deadline, :status), { include_blank: "Todos", selected: @filters[:status] } %>
        </div>
        <div>
          <%= form.label :priority, "Prioridade" %>
          <%= form.select :priority, enum_options_for(Deadline, :priority), { include_blank: "Todas", selected: @filters[:priority] } %>
        </div>
        <div>
          <%= form.label :deadline_type, "Tipo de prazo" %>
          <%= form.select :deadline_type, enum_options_for(Deadline, :deadline_type), { include_blank: "Todos", selected: @filters[:deadline_type] } %>
        </div>
        <div>
          <%= form.label :due_state, "Situação da data" %>
          <%= form.select :due_state,
                          [["Atrasado", "overdue"], ["Hoje", "today"], ["Próximos 7 dias", "upcoming"], ["Sem data", "without_due_date"]],
                          { include_blank: "Todas", selected: @filters[:due_state] } %>
        </div>
      </div>

      <div class="form-actions">
        <%= link_to "Limpar filtros", deadlines_path, class: "btn btn-secondary" %>
        <%= form.submit "Buscar", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</section>

<section class="case-section case-section--listing">
  <div class="listing-head">
    <h3>Listagem</h3>
    <p>Exibindo <strong><%= @deadlines.size %></strong> prazo(s)</p>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Processo</th>
          <th>Título</th>
          <th>Tipo</th>
          <th>Data limite</th>
          <th>Status</th>
          <th>Prorrogado em</th>
          <th>Prioridade</th>
          <th>Responsável</th>
        </tr>
      </thead>
      <tbody>
        <% if @deadlines.any? %>
          <% @deadlines.each do |deadline| %>
            <tr>
              <td>
                <% if deadline.legal_case.present? %>
                  <%= link_to deadline.legal_case.internal_number, legal_case_path(deadline.legal_case) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td><%= deadline.title %></td>
              <td><%= deadline.deadline_type.present? ? enum_label(Deadline, :deadline_type, deadline.deadline_type) : "-" %></td>
              <td><%= deadline.due_date || "-" %></td>
              <td><%= enum_label(Deadline, :status, deadline.status) %></td>
              <td><%= deadline.respond_to?(:extended_at) && deadline.extended_at.present? ? l(deadline.extended_at, format: :short) : "-" %></td>
              <td><%= deadline.priority.present? ? enum_label(Deadline, :priority, deadline.priority) : "-" %></td>
              <td><%= deadline.responsible_name.presence || "-" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="table-empty-state">Nenhum prazo cadastrado.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
