<% content_for :title, "Prazos" %>

<% content_for :topbar_actions do %>
  <%= link_to "Novo prazo", new_deadline_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Processo</th>
          <th>Título</th>
          <th>Tipo</th>
          <th>Data limite</th>
          <th>Status</th>
          <th>Prioridade</th>
          <th>Responsável</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @deadlines.any? %>
          <% @deadlines.each do |deadline| %>
            <tr>
              <td><%= deadline.legal_case&.internal_number || "-" %></td>
              <td><%= deadline.title %></td>
              <td><%= deadline.deadline_type.present? ? enum_label(Deadline, :deadline_type, deadline.deadline_type) : "-" %></td>
              <td><%= deadline.due_date || "-" %></td>
              <td><%= enum_label(Deadline, :status, deadline.status) %></td>
              <td><%= deadline.priority.present? ? enum_label(Deadline, :priority, deadline.priority) : "-" %></td>
              <td><%= deadline.responsible_name.presence || "-" %></td>
              <td>
                <div class="table-actions">
                  <%= link_to "Ver", deadline_path(deadline), class: "btn btn-secondary" %>
                  <%= link_to "Editar", edit_deadline_path(deadline), class: "btn btn-secondary" %>
                  <%= button_to "Excluir", deadline_path(deadline), method: :delete, class: "btn btn-danger", form: { class: "table-action-form", data: { turbo_confirm: "Excluir este prazo?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="table-empty-state">Nenhum prazo cadastrado.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
