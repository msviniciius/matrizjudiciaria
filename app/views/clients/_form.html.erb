<% back_path = local_assigns[:back_path] %>
<% show_path = local_assigns[:show_path] %>
<% show_label = local_assigns[:show_label] || "Ver" %>

<%= form_with(model: client, class: "app-form aurora-form", data: { inline_validation_form: true }) do |form| %>
  <% if client.errors.any? %>
    <div class="form-errors aurora-form__errors">
      <h2>Foram encontrados <%= pluralize(client.errors.count, "erro", "erros") %> neste cadastro:</h2>
      <ul>
        <% client.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="form-section aurora-form__section">
    <div class="dashboard-section__head">
      <h3>Identificação</h3>
      <p>Informe os dados essenciais para localizar e identificar o cliente.</p>
    </div>
    <p class="form-hint">Os campos com <strong>*</strong> são obrigatórios.</p>
    <div class="form-grid">
      <div>
        <%= form.label :full_name, "Nome completo *" %>
        <%= form.text_field :full_name, required: true, data: { required_field: true } %>
        <p class="field-inline-warning" data-field-error-for="client_full_name" hidden>Informe o nome completo.</p>
      </div>

      <div>
        <%= form.label :cpf_cnpj, "CPF/CNPJ *" %>
        <%= form.text_field :cpf_cnpj, required: true, data: { mask: "cpf_cnpj", required_field: true }, inputmode: "numeric" %>
        <p class="field-inline-warning" data-field-error-for="client_cpf_cnpj" hidden>Informe CPF/CNPJ.</p>
      </div>

      <div>
        <%= form.label :birth_date, "Data de nascimento (opcional)" %>
        <%= form.date_field :birth_date %>
      </div>

      <div>
        <%= form.label :rg, "RG (opcional)" %>
        <%= form.text_field :rg, data: { mask: "rg" }, inputmode: "numeric" %>
      </div>

      <div>
        <%= form.label :marital_status, "Estado civil (opcional)" %>
        <%= form.select :marital_status, [
          [ "Solteiro(a)", "solteiro" ],
          [ "Casado(a)", "casado" ],
          [ "União estável", "uniao_estavel" ],
          [ "Divorciado(a)", "divorciado" ],
          [ "Viúvo(a)", "viuvo" ],
          [ "Separado(a)", "separado" ]
        ], { include_blank: "Selecione o estado civil" } %>
      </div>

      <div>
        <%= form.label :profession, "Profissão (opcional)" %>
        <%= form.text_field :profession %>
      </div>
    </div>
  </section>

  <section class="form-section aurora-form__section">
    <div class="dashboard-section__head">
      <h3>Contato</h3>
      <p>Mantenha os canais de comunicação atualizados.</p>
    </div>
    <div class="form-grid">
      <div>
        <%= form.label :phone, "Telefone (opcional)" %>
        <%= form.text_field :phone, data: { mask: "phone" }, inputmode: "numeric" %>
      </div>

      <div>
        <%= form.label :whatsapp, "WhatsApp (opcional)" %>
        <%= form.text_field :whatsapp, data: { mask: "phone" }, inputmode: "numeric" %>
      </div>

      <div class="field-full">
        <%= form.label :email, "E-mail (opcional)" %>
        <%= form.text_field :email %>
      </div>
    </div>
  </section>

  <section class="form-section aurora-form__section">
    <div class="dashboard-section__head">
      <h3>Endereço</h3>
      <p>Use o CEP para preencher automaticamente os dados disponíveis.</p>
    </div>
    <div class="form-grid">
      <div>
        <%= form.label :zip_code do %>
          CEP
          <span class="field-help" title="Ao informar o CEP, endereço/cidade/UF serão preenchidos automaticamente." aria-label="Ao informar o CEP, endereço/cidade/UF serão preenchidos automaticamente.">?</span>
        <% end %>
        <%= form.text_field :zip_code, data: { mask: "cep", cep_lookup: true }, inputmode: "numeric" %>
      </div>

      <div class="field-full">
        <%= form.label :address %>
        <%= form.text_field :address, data: { cep_lookup_street: true } %>
      </div>

      <div>
        <%= form.label :city %>
        <%= form.text_field :city, data: { cep_lookup_city: true } %>
      </div>

      <div>
        <%= form.label :state %>
        <%= form.text_field :state, data: { cep_lookup_state: true, mask: "uf" }, inputmode: "text" %>
      </div>
    </div>
  </section>

  <section class="form-section aurora-form__section">
    <div class="dashboard-section__head">
      <h3>Informações adicionais</h3>
      <p>Registre informações complementares e observações importantes.</p>
    </div>
    <div class="form-grid">
      <div>
        <%= form.label :mother_name %>
        <%= form.text_field :mother_name %>
      </div>

      <div>
        <%= form.label :father_name %>
        <%= form.text_field :father_name %>
      </div>

      <div class="field-full">
        <%= form.label :dados_gov, "Dados GOV (e-mail e senha)" %>
        <%= form.textarea :dados_gov %>
      </div>

      <div class="field-full">
        <%= form.label :notes, "Observações (opcional)" %>
        <%= form.textarea :notes %>
      </div>

      <div class="field-full">
        <label class="checkbox-field">
          <%= form.check_box :cadastro_pendente %>
          <span>Cadastro pendente</span>
        </label>
      </div>
    </div>
  </section>

  <div class="form-actions aurora-form__actions">
    <% if back_path.present? %>
      <%= link_to "Voltar", back_path, class: "btn btn-secondary" %>
    <% end %>
    <% if show_path.present? %>
      <%= link_to show_label, show_path, class: "btn btn-secondary" %>
    <% end %>
    <%= form.submit client.persisted? ? "Salvar cliente" : "Cadastrar cliente", class: "btn btn-primary" %>
  </div>
<% end %>
