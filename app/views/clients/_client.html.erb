<div id="<%= dom_id client %>">
  <div>
    <strong><%= Client.human_attribute_name(:full_name) %>:</strong>
    <%= client.full_name %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:cpf_cnpj) %>:</strong>
    <%= client.cpf_cnpj %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:rg) %>:</strong>
    <%= client.rg %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:birth_date) %>:</strong>
    <%= client.birth_date %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:marital_status) %>:</strong>
    <%= client.marital_status %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:profession) %>:</strong>
    <%= client.profession %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:phone) %>:</strong>
    <%= client.phone %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:whatsapp) %>:</strong>
    <%= client.whatsapp %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:email) %>:</strong>
    <%= client.email %>
  </div>

  <% if client.dados_gov.present? %>
    <div>
      <strong><%= Client.human_attribute_name(:dados_gov) %>:</strong>
      <%= simple_format(client.dados_gov) %>
    </div>
  <% end %>

  <div>
    <strong><%= Client.human_attribute_name(:zip_code) %>:</strong>
    <%= client.zip_code %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:address) %>:</strong>
    <%= client.address %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:city) %>:</strong>
    <%= client.city %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:state) %>:</strong>
    <%= client.state %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:mother_name) %>:</strong>
    <%= client.mother_name %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:father_name) %>:</strong>
    <%= client.father_name %>
  </div>

  <div>
    <strong><%= Client.human_attribute_name(:notes) %>:</strong>
    <%= client.notes %>
  </div>
</div>
