<% content_for :title, "Clientes" %>

<% content_for :topbar_actions do %>
  <%= link_to "Novo cliente", new_client_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section case-section--filters">
  <%= form_with url: clients_path, method: :get, local: true, class: "main-filters", data: { main_filters: true, filters_open: @advanced_filters_open } do |form| %>
    <div class="main-filters__bar">
      <button
        type="button"
        class="main-filters__toggle"
        data-main-filters-toggle
        aria-expanded="<%= @advanced_filters_open ? 'true' : 'false' %>"
      >
        <span aria-hidden="true"><%= @advanced_filters_open ? "▾" : "▸" %></span>
        Filtrar
      </button>

      <%= form.text_field :q, value: @filters[:q], placeholder: "Nome, CPF/CNPJ, telefone ou e-mail", class: "main-filters__q" %>

      <%= form.submit "Buscar", class: "main-filters__submit" %>
    </div>

    <div class="main-filters__advanced <%= "is-open" if @advanced_filters_open %>" data-main-filters-advanced>
      <div class="form-grid">
        <div>
          <%= form.label :cadastro_pendente, "Status do cadastro" %>
          <%= form.select :cadastro_pendente, [["Pendente", "true"], ["Completo", "false"]], { include_blank: "Todos", selected: @filters[:cadastro_pendente] } %>
        </div>
        <div>
          <%= form.label :city, "Cidade" %>
          <%= form.text_field :city, value: @filters[:city], placeholder: "Cidade do cliente" %>
        </div>
      </div>

      <div class="form-actions">
        <%= link_to "Limpar filtros", clients_path, class: "btn btn-secondary" %>
        <%= form.submit "Buscar", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</section>

<section class="case-section case-section--listing">
  <div class="listing-head">
    <h3>Listagem</h3>
    <p>Exibindo <strong><%= @clients.size %></strong> cliente(s)</p>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>CPF/CNPJ</th>
          <th>Telefone</th>
          <th>E-mail</th>
          <th>Status</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @clients.any? %>
          <% @clients.each do |client| %>
            <tr>
              <td><%= client.full_name %></td>
              <td><%= client.cpf_cnpj.presence || "-" %></td>
              <td><%= client.phone.presence || "-" %></td>
              <td><%= client.email.presence || "-" %></td>
              <td><%= client.cadastro_pendente? ? "Cadastro pendente" : "Completo" %></td>
              <td class="table-actions">
                <button
                  type="button"
                  class="btn btn-secondary btn-icon"
                  data-open-client-processes-modal="client-processes-modal-<%= client.id %>"
                  aria-label="Ver processos do cliente"
                  title="Ver processos do cliente"
                >
                  <span aria-hidden="true">&#128194;</span>
                </button>

                <%= link_to client_path(client), class: "btn btn-secondary btn-icon", aria: { label: "Ver cliente" }, title: "Ver cliente" do %>
                  <span aria-hidden="true">&#128065;</span>
                <% end %>

                <%= link_to edit_client_path(client), class: "btn btn-secondary btn-icon", aria: { label: "Editar cliente" }, title: "Editar cliente" do %>
                  <span aria-hidden="true">&#9998;</span>
                <% end %>

                <%= button_to client_path(client), method: :delete, class: "btn btn-secondary btn-icon", form: { class: "table-action-form", data: { turbo_confirm: "Excluir este cliente?" } }, aria: { label: "Excluir cliente" }, title: "Excluir cliente" do %>
                  <span aria-hidden="true">&#128465;</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="table-empty-state">Nenhum cliente cadastrado.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<% @clients.each do |client| %>
  <% client_legal_cases = client.legal_cases.sort_by(&:updated_at).reverse %>
  <% latest_legal_cases = client_legal_cases.first(10) %>
  <dialog class="quick-client-modal" id="client-processes-modal-<%= client.id %>" hidden>
    <div class="quick-client-modal__header">
      <h3>Processos de <%= client.full_name %></h3>
      <button
        type="button"
        class="btn btn-secondary btn-icon"
        data-close-client-processes-modal
        aria-label="Fechar"
        title="Fechar"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <div class="table-wrap table-wrap--modal">
      <table>
        <thead>
          <tr>
            <th>Número</th>
            <th>Fase</th>
            <th>Status</th>
            <th>Próximo prazo</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if latest_legal_cases.any? %>
            <% latest_legal_cases.each do |legal_case| %>
              <tr>
                <td><%= link_to legal_case.internal_number, legal_case_path(legal_case) %></td>
                <td><%= enum_label(LegalCase, :phase, legal_case.phase) %></td>
                <td><%= enum_label(LegalCase, :status, legal_case.status) %></td>
                <td><%= legal_case.next_deadline_on.present? ? l(legal_case.next_deadline_on, format: :short) : "-" %></td>
                <td><%= link_to "Ver", legal_case_path(legal_case), class: "btn btn-secondary btn-xs" %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="table-empty-state">Este cliente ainda não possui processos cadastrados.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="form-actions quick-client-modal__actions">
      <%= link_to "Ver todos", client_path(client), class: "btn btn-secondary" %>
    </div>
  </dialog>
<% end %>
