<% content_for :title, "Painel" %>

<% content_for :topbar_actions do %>
  <%= link_to "Fechamento diário", daily_closure_legal_cases_path, class: "btn btn-secondary" %>
  <%= link_to "Novo processo", new_legal_case_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section">
  <h3>Relatórios Rápidos</h3>
  <div class="report-grid">
    <article class="report-card">
      <p class="report-label">Com prazo próximo</p>
      <p class="report-value"><%= @report_counts[:prazo_proximo] %></p>
    </article>
    <article class="report-card">
      <p class="report-label">Sem prazo</p>
      <p class="report-value"><%= @report_counts[:sem_prazo] %></p>
    </article>
    <article class="report-card">
      <p class="report-label">Com perícia</p>
      <p class="report-value"><%= @report_counts[:com_pericia] %></p>
    </article>
    <article class="report-card">
      <p class="report-label">Com exigência pendente</p>
      <p class="report-value"><%= @report_counts[:com_exigencia_pendente] %></p>
    </article>
    <article class="report-card">
      <p class="report-label">Processos em risco</p>
      <p class="report-value"><%= @report_counts[:saude_critica] %></p>
    </article>
  </div>
</section>

<section class="case-section">
  <h3>Processos por fase</h3>
  <div class="report-grid">
    <% @report_counts[:por_fase].each do |phase, count| %>
      <article class="report-card">
        <p class="report-label"><%= enum_label(LegalCase, :phase, phase) %></p>
        <p class="report-value"><%= count %></p>
      </article>
    <% end %>
  </div>
</section>

<section class="case-section">
  <h3>Central de Risco</h3>
  <div class="risk-grid">
    <article class="risk-card">
      <div class="risk-card__head">
        <p>Vence hoje</p>
        <span class="status-pill status-pill--warning"><%= @risk_counts[:vence_hoje] %></span>
      </div>
      <% if @risk_queues[:vence_hoje].any? %>
        <ul class="risk-list">
          <% @risk_queues[:vence_hoje].each do |legal_case| %>
            <li>
              <%= link_to legal_case.internal_number, legal_case %>
              <small>Prazo: <%= legal_case.next_deadline_on.present? ? l(legal_case.next_deadline_on, format: :short) : "-" %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Nenhum processo nesta fila.</p>
      <% end %>
    </article>

    <article class="risk-card">
      <div class="risk-card__head">
        <p>Próximas 48h</p>
        <span class="status-pill status-pill--info"><%= @risk_counts[:vence_48h] %></span>
      </div>
      <% if @risk_queues[:vence_48h].any? %>
        <ul class="risk-list">
          <% @risk_queues[:vence_48h].each do |legal_case| %>
            <li>
              <%= link_to legal_case.internal_number, legal_case %>
              <small>Prazo: <%= legal_case.next_deadline_on.present? ? l(legal_case.next_deadline_on, format: :short) : "-" %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Nenhum processo nesta fila.</p>
      <% end %>
    </article>

    <article class="risk-card">
      <div class="risk-card__head">
        <p>Atrasados</p>
        <span class="status-pill status-pill--danger"><%= @risk_counts[:atrasados] %></span>
      </div>
      <% if @risk_queues[:atrasados].any? %>
        <ul class="risk-list">
          <% @risk_queues[:atrasados].each do |legal_case| %>
            <li>
              <%= link_to legal_case.internal_number, legal_case %>
              <small>Prazo: <%= legal_case.next_deadline_on.present? ? l(legal_case.next_deadline_on, format: :short) : "-" %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Nenhum processo nesta fila.</p>
      <% end %>
    </article>

    <article class="risk-card">
      <div class="risk-card__head">
        <p>Sem próxima providência</p>
        <span class="status-pill status-pill--muted"><%= @risk_counts[:sem_proxima_providencia] %></span>
      </div>
      <% if @risk_queues[:sem_proxima_providencia].any? %>
        <ul class="risk-list">
          <% @risk_queues[:sem_proxima_providencia].each do |legal_case| %>
            <li>
              <%= link_to legal_case.internal_number, legal_case %>
              <small>Responsável: <%= legal_case.responsible_name.presence || "-" %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Nenhum processo nesta fila.</p>
      <% end %>
    </article>
  </div>
</section>

<section class="case-section">
  <h3>Visão Gráfica</h3>
  <% palette = [ "#1f4e79", "#4472c4", "#2f7d5b", "#9a6b2f", "#8b3a3a", "#6b5ca5", "#5d6775", "#264653", "#7f8c8d" ] %>
  <% phase_labels = @chart_data.dig(:phase, :labels) || [] %>
  <% phase_values = @chart_data.dig(:phase, :values) || [] %>
  <% phase_max = [ phase_values.max.to_i, 1 ].max %>

  <% status_labels = @chart_data.dig(:status, :labels) || [] %>
  <% status_values = @chart_data.dig(:status, :values) || [] %>
  <% status_total = status_values.sum %>
  <% cursor = 0.0 %>
  <% status_slices = status_values.each_with_index.map do |value, idx|
       pct = status_total.positive? ? (value.to_f / status_total * 100) : 0.0
       next_cursor = cursor + pct
       slice = "#{palette[idx % palette.length]} #{cursor.round(2)}% #{next_cursor.round(2)}%"
       cursor = next_cursor
       slice
     end %>
  <% donut_background = status_slices.any? ? "conic-gradient(#{status_slices.join(', ')})" : "conic-gradient(#d8cfbe 0% 100%)" %>

  <% deadline_labels = @chart_data.dig(:deadlines, :labels) || [] %>
  <% deadline_values = @chart_data.dig(:deadlines, :values) || [] %>
  <% deadline_max = [ deadline_values.max.to_i, 1 ].max %>

  <% responsible_labels = @chart_data.dig(:responsible, :labels) || [] %>
  <% responsible_values = @chart_data.dig(:responsible, :values) || [] %>
  <% responsible_max = [ responsible_values.max.to_i, 1 ].max %>

  <div class="dashboard-charts-grid">
    <article class="dashboard-chart-card">
      <h4>Processos por fase</h4>
      <% if phase_values.any? %>
        <div class="chart-bars chart-bars--vertical">
          <% phase_values.each_with_index do |value, idx| %>
            <div class="chart-bars__item has-tooltip" data-tooltip="<%= "#{phase_labels[idx]}: #{value} processos" %>">
              <span class="chart-bars__value"><%= value %></span>
              <div class="chart-bars__bar-wrap">
                <div class="chart-bars__bar" style="height: <%= ((value.to_f / phase_max) * 100).round(2) %>%; background-color: #2f5f8f;"></div>
              </div>
              <span class="chart-bars__label" title="<%= phase_labels[idx] %>"><%= phase_labels[idx].to_s.truncate(18) %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="empty-state">Sem dados para o gráfico.</p>
      <% end %>
    </article>

    <article class="dashboard-chart-card">
      <h4>Status operacional</h4>
      <% if status_values.any? %>
        <div class="chart-donut-wrap">
          <div class="chart-donut" style="background: <%= donut_background %>;">
            <span><%= status_total %></span>
          </div>
          <ul class="chart-legend">
            <% status_labels.each_with_index do |label, idx| %>
              <li class="has-tooltip" data-tooltip="<%= "#{label}: #{status_values[idx]} processos" %>">
                <span class="chart-legend__color" style="background-color: <%= palette[idx % palette.length] %>;"></span>
                <span><%= label %> (<%= status_values[idx] %>)</span>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="empty-state">Sem dados para o gráfico.</p>
      <% end %>
    </article>

    <article class="dashboard-chart-card">
      <h4>Risco de prazos</h4>
      <% if deadline_values.any? %>
        <div class="chart-bars chart-bars--vertical">
          <% deadline_values.each_with_index do |value, idx| %>
            <div class="chart-bars__item has-tooltip" data-tooltip="<%= "#{deadline_labels[idx]}: #{value}" %>">
              <span class="chart-bars__value"><%= value %></span>
              <div class="chart-bars__bar-wrap">
                <div class="chart-bars__bar" style="height: <%= ((value.to_f / deadline_max) * 100).round(2) %>%; background-color: <%= palette[idx % palette.length] %>;"></div>
              </div>
              <span class="chart-bars__label" title="<%= deadline_labels[idx] %>"><%= deadline_labels[idx] %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="empty-state">Sem dados para o gráfico.</p>
      <% end %>
    </article>

    <article class="dashboard-chart-card">
      <h4>Carga por responsável</h4>
      <% if responsible_values.any? %>
        <div class="chart-bars chart-bars--horizontal">
          <% responsible_values.each_with_index do |value, idx| %>
            <div class="chart-bars__row has-tooltip" data-tooltip="<%= "#{responsible_labels[idx]}: #{value} processos" %>">
              <span class="chart-bars__row-label" title="<%= responsible_labels[idx] %>"><%= responsible_labels[idx].to_s.truncate(24) %></span>
              <div class="chart-bars__row-track">
                <div class="chart-bars__row-bar" style="width: <%= ((value.to_f / responsible_max) * 100).round(2) %>%;"></div>
              </div>
              <span class="chart-bars__row-value"><%= value %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="empty-state">Sem dados para o gráfico.</p>
      <% end %>
    </article>
  </div>
</section>
