<% content_for :title, "Painel" %>

<% content_for :topbar_actions do %>
  <%= link_to "Fechamento diário", daily_closure_legal_cases_path, class: "btn btn-secondary" %>
  <%= link_to "Novo andamento", new_process_movement_path, class: "btn btn-secondary" %>
  <%= link_to "Nova tarefa", new_task_path, class: "btn btn-secondary" %>
  <%= link_to "Novo prazo", new_deadline_path, class: "btn btn-secondary" %>
  <%= link_to "Novo processo", new_legal_case_path, class: "btn btn-primary" %>
<% end %>

<% if @unit_selection_required %>
  <dialog class="quick-client-modal quick-client-modal--locked" data-force-unit-modal hidden>
    <div class="quick-client-modal__header">
      <h3>Selecionar unidade</h3>
    </div>
    <p class="form-hint">Você precisa escolher uma unidade para continuar.</p>
    <div class="form-grid">
      <div class="field-full">
        <% if @available_units.any? %>
          <%= form_with url: unit_session_path, method: :post, class: "app-form", local: true do |form| %>
            <%= form.label :unit_id, "Unidade" %>
            <%= form.select :unit_id, options_from_collection_for_select(@available_units, :id, :name), { include_blank: "Selecione" }, required: true %>
            <div class="form-actions" style="margin-top: 12px;">
              <%= form.submit "Entrar na unidade", class: "btn btn-primary" %>
            </div>
          <% end %>
        <% else %>
          <p class="empty-state">Nenhuma unidade vinculada ao seu usuário.</p>
        <% end %>
      </div>
      <% if current_user&.admin? %>
        <div class="field-full">
          <%= form_with url: unit_session_path, method: :post, class: "app-form", local: true do |form| %>
            <%= form.hidden_field :all_units, value: "1" %>
            <%= form.submit "Todas Unidades", class: "btn btn-secondary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </dialog>
<% end %>

<% unless @unit_selection_required %>
<section class="case-section dashboard-section">
  <div class="dashboard-section__head">
    <h3>Resumo Operacional</h3>
    <p>Visão rápida para priorizar o dia.</p>
  </div>

  <div class="report-grid report-grid--kpi">
    <article class="report-card report-card--warning">
      <span class="report-icon" aria-hidden="true">&#9200;</span>
      <p class="report-label">Com prazo próximo</p>
      <p class="report-value"><%= @report_counts[:prazo_proximo] %></p>
    </article>
    <article class="report-card report-card--neutral">
      <span class="report-icon" aria-hidden="true">&#128197;</span>
      <p class="report-label">Sem prazo</p>
      <p class="report-value"><%= @report_counts[:sem_prazo] %></p>
    </article>
    <article class="report-card report-card--info">
      <span class="report-icon" aria-hidden="true">&#9877;</span>
      <p class="report-label">Com perícia</p>
      <p class="report-value"><%= @report_counts[:com_pericia] %></p>
    </article>
    <article class="report-card report-card--attention">
      <span class="report-icon" aria-hidden="true">&#9888;</span>
      <p class="report-label">Com exigência pendente</p>
      <p class="report-value"><%= @report_counts[:com_exigencia_pendente] %></p>
    </article>
    <article class="report-card report-card--danger">
      <span class="report-icon" aria-hidden="true">&#10071;</span>
      <p class="report-label">Processos em risco</p>
      <p class="report-value"><%= @report_counts[:saude_critica] %></p>
    </article>
  </div>
</section>
<% end %>

<section class="case-section dashboard-section">
  <div class="dashboard-section__head">
    <h3>Agenda de Hoje</h3>
    <p>O que exige atenção imediata na operação.</p>
  </div>

  <div class="report-grid report-grid--kpi">
    <%= link_to deadlines_path(due_state: "overdue"), class: "report-card report-card--danger report-card--link", title: "Ver prazos vencidos" do %>
      <span class="report-icon" aria-hidden="true">&#9888;</span>
      <p class="report-label">Prazos vencidos</p>
      <p class="report-value"><%= @today_counts[:deadlines_overdue] %></p>
    <% end %>
    <%= link_to deadlines_path(due_state: "today"), class: "report-card report-card--warning report-card--link", title: "Ver prazos de hoje" do %>
      <span class="report-icon" aria-hidden="true">&#9200;</span>
      <p class="report-label">Prazos para hoje</p>
      <p class="report-value"><%= @today_counts[:deadlines_today] %></p>
    <% end %>
    <%= link_to tasks_path(due_state: "overdue"), class: "report-card report-card--danger report-card--link", title: "Ver tarefas atrasadas" do %>
      <span class="report-icon" aria-hidden="true">&#10071;</span>
      <p class="report-label">Tarefas atrasadas</p>
      <p class="report-value"><%= @today_counts[:tasks_overdue] %></p>
    <% end %>
    <%= link_to tasks_path(due_state: "today"), class: "report-card report-card--info report-card--link", title: "Ver tarefas de hoje" do %>
      <span class="report-icon" aria-hidden="true">&#10003;</span>
      <p class="report-label">Tarefas para hoje</p>
      <p class="report-value"><%= @today_counts[:tasks_today] %></p>
    <% end %>
    <%= link_to daily_closure_legal_cases_path(reference_date: Date.current), class: "report-card report-card--neutral report-card--link", title: "Abrir fechamento diário" do %>
      <span class="report-icon" aria-hidden="true">&#128197;</span>
      <p class="report-label">Data de referência</p>
      <p class="report-value"><%= l(Date.current, format: :short) %></p>
    <% end %>
  </div>
</section>

<section class="case-section dashboard-section">
  <div class="dashboard-section__head">
    <h3>Últimos Andamentos</h3>
    <p>Registros mais recentes do histórico operacional.</p>
  </div>

  <% if @recent_movements.any? %>
    <div class="dashboard-feed">
      <% @recent_movements.each do |movement| %>
        <article class="dashboard-feed__item">
          <header class="dashboard-feed__head">
            <strong><%= movement.display_title.presence || "Andamento sem título" %></strong>
            <span><%= movement.event_date.present? ? l(movement.event_date, format: :short) : "-" %></span>
          </header>
          <p>
            <%= movement.process.internal_number %>
            <% if movement.movement_type.present? %>
              • <%= movement.movement_type.name %>
            <% end %>
          </p>
          <%= link_to "Ver processo", legal_case_path(movement.process), class: "dashboard-feed__link" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="empty-state">Ainda não há andamentos registrados para exibir.</p>
  <% end %>
</section>

<section class="case-section dashboard-section">
  <div class="dashboard-section__head">
    <h3>Pendências Críticas</h3>
    <p>Itens com risco operacional e ação imediata recomendada.</p>
  </div>

  <div class="critical-grid">
    <article class="critical-card critical-card--muted">
      <div class="risk-card__head">
        <p>Processos sem responsável</p>
        <span class="status-pill status-pill--muted"><%= @critical_queues[:without_responsible].size %></span>
      </div>
      <% if @critical_queues[:without_responsible].any? %>
        <ul class="critical-list">
          <% @critical_queues[:without_responsible].each do |legal_case| %>
            <li>
              <div>
                <%= link_to legal_case.internal_number, legal_case_path(legal_case) %>
                <small>Atualizado em <%= l(legal_case.updated_at, format: :short) %></small>
              </div>
              <%= form_with url: quick_update_case_responsible_path(legal_case), method: :patch, class: "critical-inline-form", local: true do |form| %>
                <%= form.text_field :responsible_name, value: legal_case.responsible_name, placeholder: "Responsável", required: true %>
                <%= form.submit "Salvar", class: "btn btn-secondary btn-xs" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Nenhum processo sem responsável.</p>
      <% end %>
    </article>

    <article class="critical-card critical-card--warning">
      <div class="risk-card__head">
        <p>Sem próxima providência</p>
        <span class="status-pill status-pill--warning"><%= @critical_queues[:without_next_action].size %></span>
      </div>
      <% if @critical_queues[:without_next_action].any? %>
        <ul class="critical-list">
          <% @critical_queues[:without_next_action].each do |legal_case| %>
            <li>
              <div>
                <%= link_to legal_case.internal_number, legal_case_path(legal_case) %>
                <small>Status: <%= enum_label(LegalCase, :status, legal_case.status) %> • Próxima providência não definida</small>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Todos os processos têm próxima providência.</p>
      <% end %>
    </article>

    <article class="critical-card critical-card--danger">
      <div class="risk-card__head">
        <p>Prazos vencidos sem justificativa</p>
        <span class="status-pill status-pill--danger"><%= @critical_queues[:overdue_deadlines_without_reason].size %></span>
      </div>
      <% if @critical_queues[:overdue_deadlines_without_reason].any? %>
        <ul class="critical-list">
          <% @critical_queues[:overdue_deadlines_without_reason].each do |deadline| %>
            <li>
              <div>
                <%= link_to deadline.title, deadline_path(deadline) %>
                <small><%= deadline.legal_case.internal_number %> • Venceu em <%= l(deadline.due_date, format: :short) %> • Sem justificativa</small>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Não há prazos vencidos sem justificativa.</p>
      <% end %>
    </article>

  </div>
</section>

<section class="case-section dashboard-section">
  <div class="dashboard-section__head">
    <h3>Distribuição por Fase</h3>
    <p>Entenda onde está a maior carga do escritório.</p>
  </div>

  <div class="report-grid report-grid--phases">
    <% @report_counts[:por_fase].each do |phase, count| %>
      <article class="report-card">
        <p class="report-label"><%= enum_label(LegalCase, :phase, phase) %></p>
        <p class="report-value"><%= count %></p>
      </article>
    <% end %>
  </div>
</section>

<section class="case-section dashboard-section">
  <div class="dashboard-section__head">
    <h3>Central de Risco</h3>
    <p>Filas que exigem ação imediata.</p>
  </div>

  <div class="risk-grid">
    <article class="risk-card risk-card--warning">
      <div class="risk-card__head">
        <p>Vence hoje</p>
        <span class="status-pill status-pill--warning"><%= @risk_counts[:vence_hoje] %></span>
      </div>
      <% if @risk_queues[:vence_hoje].any? %>
        <ul class="risk-list">
          <% @risk_queues[:vence_hoje].each do |legal_case| %>
            <li>
              <%= link_to legal_case.internal_number, legal_case %>
              <small>Prazo: <%= legal_case.next_deadline_on.present? ? l(legal_case.next_deadline_on, format: :short) : "-" %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Nenhum processo nesta fila.</p>
      <% end %>
    </article>

    <article class="risk-card risk-card--info">
      <div class="risk-card__head">
        <p>Próximas 48h</p>
        <span class="status-pill status-pill--info"><%= @risk_counts[:vence_48h] %></span>
      </div>
      <% if @risk_queues[:vence_48h].any? %>
        <ul class="risk-list">
          <% @risk_queues[:vence_48h].each do |legal_case| %>
            <li>
              <%= link_to legal_case.internal_number, legal_case %>
              <small>Prazo: <%= legal_case.next_deadline_on.present? ? l(legal_case.next_deadline_on, format: :short) : "-" %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Nenhum processo nesta fila.</p>
      <% end %>
    </article>

    <article class="risk-card risk-card--danger">
      <div class="risk-card__head">
        <p>Atrasados</p>
        <span class="status-pill status-pill--danger"><%= @risk_counts[:atrasados] %></span>
      </div>
      <% if @risk_queues[:atrasados].any? %>
        <ul class="risk-list">
          <% @risk_queues[:atrasados].each do |legal_case| %>
            <li>
              <%= link_to legal_case.internal_number, legal_case %>
              <small>Prazo: <%= legal_case.next_deadline_on.present? ? l(legal_case.next_deadline_on, format: :short) : "-" %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Nenhum processo nesta fila.</p>
      <% end %>
    </article>

    <article class="risk-card risk-card--muted">
      <div class="risk-card__head">
        <p>Sem próxima providência</p>
        <span class="status-pill status-pill--muted"><%= @risk_counts[:sem_proxima_providencia] %></span>
      </div>
      <% if @risk_queues[:sem_proxima_providencia].any? %>
        <ul class="risk-list">
          <% @risk_queues[:sem_proxima_providencia].each do |legal_case| %>
            <li>
              <%= link_to legal_case.internal_number, legal_case %>
              <small>Responsável: <%= legal_case.responsible_name.presence || "-" %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Nenhum processo nesta fila.</p>
      <% end %>
    </article>
  </div>
</section>

<section class="case-section dashboard-section">
  <div class="dashboard-section__head">
    <h3>Visão Gráfica</h3>
    <p>Distribuição operacional resumida.</p>
  </div>

  <div id="dashboard-charts-root" class="dashboard-charts-grid">
    <article class="dashboard-chart-card">
      <h4>Processos por fase</h4>
      <canvas id="dashboard-chart-phase"></canvas>
    </article>

    <article class="dashboard-chart-card">
      <h4>Status operacional</h4>
      <canvas id="dashboard-chart-status"></canvas>
    </article>

    <article class="dashboard-chart-card">
      <h4>Risco de prazos</h4>
      <canvas id="dashboard-chart-deadlines"></canvas>
    </article>

    <article class="dashboard-chart-card">
      <h4>Carga por responsável</h4>
      <canvas id="dashboard-chart-responsible"></canvas>
    </article>
  </div>

  <script id="dashboard-charts-data" type="application/json">
    <%= raw(@chart_data.to_json) %>
  </script>
</section>
