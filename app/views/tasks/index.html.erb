<% content_for :title, "Tarefas" %>

<div id="react-tasks-root"></div>

<noscript>
  <section class="case-section case-section--listing">
    <div class="listing-head"><h3>Listagem</h3><p>Exibindo <strong><%= @tasks.size %></strong> tarefa(s)</p></div>
    <div class="table-wrap"><table><thead><tr><th>Processo</th><th>Tarefa</th><th>Data limite</th><th>Status</th><th>Prioridade</th><th>Responsável</th><th>Ações</th></tr></thead><tbody>
      <% if @tasks.any? %>
        <% @tasks.each do |task| %><tr><td><%= link_to task.legal_case.internal_number, legal_case_path(task.legal_case) %></td><td><%= link_to task.title, task_path(task) %></td><td><%= task.due_date.present? ? l(task.due_date, format: :short) : "-" %></td><td><%= enum_label(Task, :status, task.status) %></td><td><%= enum_label(Task, :priority, task.priority) %></td><td><%= task.responsible_name.presence || "-" %></td><td class="table-actions"><%= link_to "Editar", edit_task_path(task), class: "btn btn-secondary" %><%= button_to "Excluir", task_path(task), method: :delete, class: "btn btn-secondary", form: { data: { turbo_confirm: "Excluir esta tarefa?" } } %></td></tr><% end %>
      <% else %><tr><td colspan="7" class="table-empty-state">Nenhuma tarefa encontrada.</td></tr><% end %>
    </tbody></table></div>
  </section>
</noscript>
