<% content_for :title, "Tarefas" %>

<% content_for :topbar_actions do %>
  <%= link_to "Nova tarefa", new_task_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Processo</th>
          <th>Título</th>
          <th>Status</th>
          <th>Prioridade</th>
          <th>Data limite</th>
          <th>Responsável</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @tasks.any? %>
          <% @tasks.each do |task| %>
            <tr>
              <td>
                <% if task.legal_case.present? %>
                  <%= link_to task.legal_case.internal_number, legal_case_path(task.legal_case) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td><%= task.title %></td>
              <td><%= enum_label(Task, :status, task.status) %></td>
              <td><%= task.priority.present? ? enum_label(Task, :priority, task.priority) : "-" %></td>
              <td><%= task.due_date || "-" %></td>
              <td><%= task.responsible_name.presence || "-" %></td>
              <td>
                <div class="table-actions">
                  <%= link_to "Ver", task_path(task), class: "btn btn-secondary" %>
                  <%= link_to "Editar", edit_task_path(task), class: "btn btn-secondary" %>
                  <%= button_to "Excluir", task_path(task), method: :delete, class: "btn btn-danger", form: { class: "table-action-form", data: { turbo_confirm: "Excluir esta tarefa?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="table-empty-state">Nenhuma tarefa cadastrada.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
