<% content_for :title, "Tarefas" %>

<% content_for :topbar_actions do %>
  <%= link_to "Nova tarefa", new_task_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section case-section--filters">
  <%= form_with url: tasks_path, method: :get, local: true, class: "main-filters", data: { main_filters: true, filters_open: @advanced_filters_open } do |form| %>
    <div class="main-filters__bar">
      <button
        type="button"
        class="main-filters__toggle"
        data-main-filters-toggle
        aria-expanded="<%= @advanced_filters_open ? 'true' : 'false' %>"
      >
        <span aria-hidden="true"><%= @advanced_filters_open ? "▾" : "▸" %></span>
        Filtrar
      </button>

      <%= form.text_field :q, value: @filters[:q], placeholder: "Processo, título, descrição ou responsável", class: "main-filters__q" %>

      <%= form.submit "Buscar", class: "main-filters__submit" %>
    </div>

    <div class="main-filters__advanced <%= "is-open" if @advanced_filters_open %>" data-main-filters-advanced>
      <div class="form-grid">
        <div>
          <%= form.label :status, "Status" %>
          <%= form.select :status, enum_options_for(Task, :status), { include_blank: "Todos", selected: @filters[:status] } %>
        </div>
        <div>
          <%= form.label :priority, "Prioridade" %>
          <%= form.select :priority, enum_options_for(Task, :priority), { include_blank: "Todas", selected: @filters[:priority] } %>
        </div>
        <div>
          <%= form.label :responsible_name, "Responsável" %>
          <%= form.text_field :responsible_name, value: @filters[:responsible_name], placeholder: "Nome do responsável" %>
        </div>
        <div>
          <%= form.label :due_state, "Situação da data" %>
          <%= form.select :due_state,
                          [["Atrasado", "overdue"], ["Hoje", "today"], ["Próximos 7 dias", "upcoming"], ["Sem data", "without_due_date"]],
                          { include_blank: "Todas", selected: @filters[:due_state] } %>
        </div>
      </div>

      <div class="form-actions">
        <%= link_to "Limpar filtros", tasks_path, class: "btn btn-secondary" %>
        <%= form.submit "Buscar", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</section>

<section class="case-section case-section--listing">
  <div class="listing-head">
    <h3>Listagem</h3>
    <p>Exibindo <strong><%= @tasks.size %></strong> tarefa(s)</p>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Processo</th>
          <th>Título</th>
          <th>Status</th>
          <th>Prioridade</th>
          <th>Data limite</th>
          <th>Responsável</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @tasks.any? %>
          <% @tasks.each do |task| %>
            <tr>
              <td>
                <% if task.legal_case.present? %>
                  <%= link_to task.legal_case.internal_number, legal_case_path(task.legal_case) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td><%= task.title %></td>
              <td><%= enum_label(Task, :status, task.status) %></td>
              <td><%= task.priority.present? ? enum_label(Task, :priority, task.priority) : "-" %></td>
              <td><%= task.due_date || "-" %></td>
              <td><%= task.responsible_name.presence || "-" %></td>
              <td>
                <div class="table-actions">
                  <%= link_to "Ver", task_path(task), class: "btn btn-secondary" %>
                  <%= link_to "Editar", edit_task_path(task), class: "btn btn-secondary" %>
                  <%= button_to "Excluir", task_path(task), method: :delete, class: "btn btn-danger", form: { class: "table-action-form", data: { turbo_confirm: "Excluir esta tarefa?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="table-empty-state">Nenhuma tarefa cadastrada.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
