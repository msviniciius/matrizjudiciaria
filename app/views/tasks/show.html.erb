<%= render @task %>

<div class="case-actions case-actions--footer">
  <%= link_to "Editar tarefa", edit_task_path(@task), class: "btn btn-secondary" %>
  <%= link_to "Voltar", tasks_path, class: "btn btn-secondary" %>
  <%= button_to "Excluir tarefa", @task, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Tem certeza que deseja excluir esta tarefa?" } } %>
</div>
