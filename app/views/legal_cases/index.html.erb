<% content_for :title, "Processos" %>

<% content_for :topbar_actions do %>
  <%= link_to "Fechamento diário", daily_closure_legal_cases_path, class: "btn btn-secondary" %>
  <%= link_to "Novo processo", new_legal_case_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section case-section--filters">
  <%= form_with url: legal_cases_path, method: :get, local: true, class: "main-filters", data: { main_filters: true, filters_open: @advanced_filters_open } do |form| %>
    <div class="main-filters__bar">
      <button
        type="button"
        class="main-filters__toggle"
        data-main-filters-toggle
        aria-expanded="<%= @advanced_filters_open ? 'true' : 'false' %>"
      >
        <span aria-hidden="true"><%= @advanced_filters_open ? "▾" : "▸" %></span>
        Filtrar
      </button>

      <%= form.text_field :q, value: @filters[:q], placeholder: "Objeto, cliente, número interno, parte contrária...", class: "main-filters__q" %>

      <%= form.submit "Buscar", class: "main-filters__submit" %>
    </div>

    <div class="main-filters__advanced <%= "is-open" if @advanced_filters_open %>" data-main-filters-advanced>
      <div class="form-grid">
        <div>
          <%= form.label :phase, "Fase" %>
          <%= form.select :phase, enum_options_for(LegalCase, :phase), { include_blank: "Todas", selected: @filters[:phase] } %>
        </div>
        <div>
          <%= form.label :status, "Status" %>
          <%= form.select :status, enum_options_for(LegalCase, :status), { include_blank: "Todos", selected: @filters[:status] } %>
        </div>
        <div>
          <%= form.label :priority, "Prioridade" %>
          <%= form.select :priority, enum_options_for(LegalCase, :priority), { include_blank: "Todas", selected: @filters[:priority] } %>
        </div>
        <div>
          <%= form.label :responsible_name, "Responsável" %>
          <%= form.text_field :responsible_name, value: @filters[:responsible_name], placeholder: "Nome do responsável" %>
        </div>
        <div>
          <%= form.label :deadline_state, "Situação do prazo" %>
          <%= form.select :deadline_state, [
                [ "Atrasado", "overdue" ],
                [ "Vence hoje", "today" ],
                [ "Próximos 7 dias", "upcoming" ],
                [ "Sem prazo", "without_deadline" ]
              ], { include_blank: "Todas", selected: @filters[:deadline_state] } %>
        </div>
      </div>

      <div class="form-actions">
        <%= link_to "Limpar filtros", legal_cases_path, class: "btn btn-secondary" %>
        <%= form.submit "Buscar", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</section>

<section class="case-section case-section--listing">
  <div class="listing-head">
    <h3>Listagem</h3>
    <p>Exibindo <strong><%= @legal_cases.size %></strong> processo(s)</p>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Número interno</th>
          <th>Cliente</th>
          <th>Fase</th>
          <th>Status</th>
          <th>Último andamento</th>
          <th>Próximo prazo</th>
          <th>Responsável</th>
          <th>Saúde</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @legal_cases.any? %>
          <% @legal_cases.each do |legal_case| %>
            <tr>
              <td><%= link_to legal_case.internal_number, legal_case_path(legal_case) %></td>
              <td><%= legal_case.client.full_name %></td>
              <td><%= enum_label(LegalCase, :phase, legal_case.phase) %></td>
              <td><%= enum_label(LegalCase, :status, legal_case.status) %></td>
              <td><%= legal_case.last_movement.presence || "-" %></td>
              <td><%= legal_case.next_deadline_on.present? ? l(legal_case.next_deadline_on, format: :short) : "-" %></td>
              <td><%= legal_case.responsible_name.presence || "-" %></td>
              <td class="health-cell">
                <span
                  class="<%= legal_case_health_class(legal_case) %>"
                  title="<%= legal_case_primary_alert(legal_case) %>"
                  aria-label="<%= legal_case_primary_alert(legal_case) %>"
                >
                  <%= legal_case_health_label(legal_case) %>
                </span>
              </td>
              <td><%= link_to "Ver processo", legal_case, class: "btn btn-secondary" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="9" class="table-empty-state">Nenhum processo cadastrado.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
