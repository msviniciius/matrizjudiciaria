<%= form_with(model: legal_case, class: "app-form") do |form| %>
  <% if legal_case.errors.any? %>
    <div class="form-errors">
      <h2>Foram encontrados <%= pluralize(legal_case.errors.count, "erro", "erros") %> neste cadastro:</h2>
      <ul>
        <% legal_case.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% filtered_areas = LegalArea.order(:justice_branch, :name).reject { |area| area.name.to_s.strip.casecmp("Administrativo").zero? } %>
  <% grouped_areas = filtered_areas.group_by(&:justice_branch) %>
  <% grouped_options = grouped_areas.transform_values { |areas| areas.map { |area| [area.name, area.id] } } %>
  <% clients = current_office.clients.ordered.to_a %>
  <% pending_client_ids = clients.select(&:cadastro_pendente?).map(&:id) %>
  <% office_users = current_office.users.active.order(:name).to_a %>
  <% modal_exam = legal_case.process_exams.find(&:new_record?) || legal_case.process_exams.first || legal_case.process_exams.build %>

  <section class="form-section">
    <div class="dashboard-section__head">
      <h3>Dados do cliente</h3>
      <p>Selecione o cliente responsável pelo processo.</p>
    </div>
    <div class="form-grid">
      <div class="field-full">
        <%= form.label :client_id %>
        <div class="inline-client-actions">
        <%= form.collection_select :client_id,
                                     clients,
                                     :id,
                                     :display_name_with_status,
                                     { prompt: "Selecione o cliente" },
                                     data: {
                                       client_select: true,
                                       pending_client_ids: pending_client_ids.join(",")
                                     },
                                     required: true %>
          <button
            type="button"
            class="btn btn-secondary btn-icon"
            data-open-quick-client-modal
            aria-label="Cadastrar cliente"
            title="Cadastrar cliente"
          >
            <span aria-hidden="true">+</span>
          </button>
        </div>
        <p class="form-hint form-hint--warning" data-client-pending-hint hidden>
          Cliente com cadastro pendente. Complete os dados depois em Clientes.
        </p>
      </div>
    </div>
  </section>

  <section class="form-section">
    <div class="dashboard-section__head">
      <h3>Dados do Processo</h3>
      <p>Preencha as informações principais do caso.</p>
    </div>
    <div class="form-grid">
      <div>
        <%= form.label :internal_number %>
        <%= form.text_field :internal_number, readonly: true, placeholder: "Será gerado automaticamente" %>
      </div>

      <div>
        <%= form.label :legal_area_id, LegalCase.human_attribute_name(:legal_area_id) %>
        <%= form.select :legal_area_id, grouped_options_for_select(grouped_options, legal_case.legal_area_id), { include_blank: "Selecione a área" }, data: { legal_area_select: true }, required: true %>
      </div>

      <div>
        <%= form.label :process_type_id, LegalCase.human_attribute_name(:process_type_id) %>
        <% process_types = legal_case.legal_area ? legal_case.legal_area.process_types.order(:name).map { |pt| [pt.name, pt.id] } : [] %>
        <%= form.select :process_type_id, process_types, { include_blank: "Selecione o tipo" }, data: { process_type_select: true, current_process_type: legal_case.process_type_id }, required: true %>
      </div>

      <div>
        <%= form.label :entry_date %>
        <%= form.date_field :entry_date %>
      </div>

      <div>
        <%= form.label :protocol_date %>
        <%= form.date_field :protocol_date %>
      </div>

      <div>
        <%= form.label :claim_value, "Valor da causa" %>
        <%= form.text_field :claim_value, data: { mask: "currency-br" }, inputmode: "numeric" %>
      </div>

      <div class="field-full">
        <%= form.label :opposing_party %>
        <%= form.text_field :opposing_party %>
      </div>

    </div>
  </section>

  <section class="form-section">
    <div class="dashboard-section__head">
      <h3>Classificação</h3>
      <p>Defina fase, status e prioridade operacional.</p>
    </div>
    <div class="form-grid">
      <div>
        <%= form.label :phase, "Fase" %>
        <%= form.select :phase, enum_options_for(LegalCase, :phase), {}, {} %>
      </div>

      <div>
        <%= form.label :status, "Status" %>
        <%= form.select :status, enum_options_for(LegalCase, :status), {}, { required: true } %>
      </div>

      <div>
        <%= form.label :priority, "Prioridade" %>
        <%= form.select :priority, enum_options_for(LegalCase, :priority), include_blank: true %>
      </div>
    </div>
  </section>

  <section class="form-section">
    <div class="dashboard-section__head">
      <h3>Situação Atual</h3>
      <p>Snapshot de acompanhamento do processo.</p>
    </div>
    <div class="form-grid">
      <div class="field-full">
        <%= form.label :last_movement, "Último andamento" %>
        <%= form.text_field :last_movement %>
      </div>

      <div>
        <%= form.label :last_movement_at, "Data do último andamento" %>
        <%= form.datetime_local_field :last_movement_at, value: legal_case.last_movement_at&.strftime("%Y-%m-%dT%H:%M") %>
      </div>

      <div>
        <%= form.label :next_deadline_on, "Próximo prazo" %>
        <%= form.date_field :next_deadline_on %>
      </div>

      <div>
        <%= form.label :responsible_name, "Responsável atual" %>
        <% if current_user&.admin? %>
          <%= form.select :responsible_name,
                          options_for_select(office_users.map { |user| [user.name, user.name] }, legal_case.responsible_name),
                          { include_blank: "Selecione o responsável" } %>
        <% else %>
          <%= form.text_field :responsible_name, readonly: true %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="form-section">
    <div class="dashboard-section__head">
      <h3>Perícias</h3>
      <p>Ative para controlar perícias vinculadas ao processo.</p>
    </div>
    <div class="form-grid">
      <% has_existing_exams = legal_case.persisted? && legal_case.process_exams.exists? %>
      <div class="field-full">
        <% if has_existing_exams %>
          <%= form.hidden_field :tem_pericia, value: true %>
        <% else %>
          <label class="checkbox-field">
            <%= form.check_box :tem_pericia, data: { pericia_toggle: true, pericia_open_modal_on_check: true } %>
            <span>Tem perícia?</span>
          </label>
        <% end %>
      </div>

      <div class="field-full" data-pericia-section style="display: <%= legal_case.tem_pericia? ? "block" : "none" %>;">
        <div class="form-inline-actions">
          <button type="button" class="btn btn-secondary" data-open-pericia-modal>Adicionar perícia</button>
        </div>

        <% if legal_case.persisted? && legal_case.process_exams.any? %>
          <div class="table-wrap" style="margin-top: 12px;">
            <table>
              <thead>
                <tr>
                  <th>Natureza</th>
                  <th>Esfera</th>
                  <th>Data</th>
                  <th>Status</th>
                  <th>Perito</th>
                  <th class="actions-col">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% legal_case.process_exams.order(Arel.sql("scheduled_at IS NULL, scheduled_at ASC")).each do |exam| %>
                  <tr>
                    <td><%= enum_label(ProcessExam, :exam_nature, exam.exam_nature) %></td>
                    <td><%= enum_label(ProcessExam, :exam_scope, exam.exam_scope) %></td>
                    <td><%= exam.scheduled_label %></td>
                    <td><%= enum_label(ProcessExam, :status, exam.status) %></td>
                    <td><%= exam.expert_name.presence || "-" %></td>
                    <td class="table-actions">
                      <button
                        type="button"
                        class="btn btn-secondary"
                        data-edit-pericia-modal
                        data-exam-id="<%= exam.id %>"
                        data-exam-nature="<%= exam.exam_nature %>"
                        data-exam-scope="<%= exam.exam_scope %>"
                        data-exam-status="<%= exam.status %>"
                        data-exam-scheduled-at="<%= exam.scheduled_at&.strftime("%Y-%m-%dT%H:%M") %>"
                        data-exam-location="<%= exam.location.to_s %>"
                        data-exam-expert-name="<%= exam.expert_name.to_s %>"
                        data-exam-notes="<%= exam.notes.to_s %>"
                        data-exam-active="<%= exam.active? %>"
                      >
                        Editar
                      </button>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% elsif legal_case.persisted? %>
          <p class="form-hint">Nenhuma perícia cadastrada ainda.</p>
        <% end %>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <%= link_to "Voltar", legal_cases_path, class: "btn btn-secondary" %>
    <% if legal_case.persisted? %>
      <%= link_to "Ver processo", legal_case_path(legal_case), class: "btn btn-secondary" %>
    <% end %>
    <%= form.submit %>
  </div>

  <dialog class="quick-client-modal" data-pericia-modal>
    <div class="quick-client-modal__header">
      <h3>Dados da Perícia</h3>
      <button
        type="button"
        class="btn btn-secondary btn-icon"
        data-close-pericia-modal
        aria-label="Fechar"
        title="Fechar"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <div class="form-grid">
      <%= form.fields_for :process_exams, modal_exam do |exam_form| %>
        <%= exam_form.hidden_field :id %>
        <div>
          <%= exam_form.label :exam_nature, "Natureza" %>
          <%= exam_form.select :exam_nature, enum_options_for(ProcessExam, :exam_nature), include_blank: "Selecione a natureza" %>
        </div>

        <div>
          <%= exam_form.label :exam_scope, "Esfera" %>
          <%= exam_form.select :exam_scope, enum_options_for(ProcessExam, :exam_scope), include_blank: "Selecione a esfera" %>
        </div>

        <div>
          <%= exam_form.label :status, "Status" %>
          <%= exam_form.select :status, enum_options_for(ProcessExam, :status), include_blank: "Selecione o status" %>
        </div>

        <div>
          <%= exam_form.label :scheduled_at, "Data/hora" %>
          <%= exam_form.datetime_field :scheduled_at %>
        </div>

        <div>
          <%= exam_form.label :location, "Local" %>
          <%= exam_form.text_field :location %>
        </div>

        <div>
          <%= exam_form.label :expert_name, "Perito" %>
          <%= exam_form.text_field :expert_name %>
        </div>

        <div class="field-full">
          <%= exam_form.label :notes, "Observações" %>
          <%= exam_form.text_area :notes %>
        </div>

        <div>
          <label class="checkbox-field">
            <%= exam_form.check_box :active %>
            <span>Ativa</span>
          </label>
        </div>
      <% end %>
    </div>

    <div class="form-actions">
      <button type="button" class="btn btn-primary" data-save-pericia-modal>Salvar</button>
    </div>
  </dialog>
<% end %>

<dialog class="quick-client-modal" data-quick-client-modal data-endpoint="<%= quick_create_clients_path %>">
  <div class="quick-client-modal__header">
    <h3>Novo cliente (cadastro rápido)</h3>
    <button
      type="button"
      class="btn btn-secondary btn-icon"
      data-close-quick-client-modal
      aria-label="Fechar"
      title="Fechar"
    >
      <span aria-hidden="true">&times;</span>
    </button>
  </div>

  <p class="form-hint">Preencha os dados mínimos obrigatórios. O cliente será criado com cadastro pendente.</p>

  <div class="form-errors" data-quick-client-errors hidden></div>

  <div class="form-grid">
    <div class="field-full">
      <label for="quick_client_full_name">Nome completo *</label>
      <input id="quick_client_full_name" type="text" data-quick-client-field="full_name" required />
    </div>

    <div>
      <label for="quick_client_cpf_cnpj">CPF/CNPJ *</label>
      <input id="quick_client_cpf_cnpj" type="text" data-mask="cpf_cnpj" data-quick-client-field="cpf_cnpj" inputmode="numeric" required />
    </div>

    <div>
      <label for="quick_client_phone">Telefone *</label>
      <input id="quick_client_phone" type="text" data-mask="phone" data-quick-client-field="phone" inputmode="numeric" required />
    </div>

    <div>
      <label for="quick_client_whatsapp">WhatsApp</label>
      <input id="quick_client_whatsapp" type="text" data-mask="phone" data-quick-client-field="whatsapp" inputmode="numeric" />
    </div>

    <div>
      <label for="quick_client_email">E-mail</label>
      <input id="quick_client_email" type="email" data-quick-client-field="email" />
    </div>

    <div class="field-full">
      <label for="quick_client_dados_gov">Dados GOV (e-mail e senha)</label>
      <textarea id="quick_client_dados_gov" data-quick-client-field="dados_gov" rows="3"></textarea>
    </div>
  </div>

  <div class="form-actions">
    <button type="button" class="btn btn-primary" data-save-quick-client>Salvar cliente</button>
  </div>
</dialog>
