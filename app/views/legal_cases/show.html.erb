<% content_for :title, "Processo #{@legal_case.internal_number}" %>

<section class="case-summary case-summary--header">
  <div class="case-summary__header">
    <div>
      <p class="case-kicker">Processo</p>
      <h1><%= @legal_case.internal_number %></h1>
    </div>
    <div class="case-actions">
      <%= link_to "Exportar calendário", calendar_legal_case_path(@legal_case, format: :ics), class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="case-headline-grid">
    <div><strong>Fase:</strong> <span><%= enum_label(LegalCase, :phase, @legal_case.phase) %></span></div>
    <div><strong>Status:</strong> <span><%= enum_label(LegalCase, :status, @legal_case.status) %></span></div>
    <div><strong>Prioridade:</strong> <span><%= enum_label(LegalCase, :priority, @legal_case.priority) %></span></div>
    <div><strong>Último andamento:</strong> <span><%= @legal_case.last_movement.presence || "-" %></span></div>
    <div><strong>Próxima providência:</strong> <span><%= @legal_case.next_action.presence || "-" %></span></div>
    <div><strong>Próximo prazo:</strong> <span><%= @legal_case.next_deadline_on.present? ? l(@legal_case.next_deadline_on, format: :short) : "-" %></span></div>
    <div><strong>Responsável:</strong> <span><%= @legal_case.responsible_name.presence || "-" %></span></div>
    <div><strong>Saúde operacional:</strong> <span class="<%= legal_case_health_class(@legal_case) %>"><%= legal_case_health_label(@legal_case) %></span></div>
    <div class="header-alerts">
      <% if @legal_case.prazo_alerta? %>
        <span class="status-pill status-pill--warning">Prazo próximo</span>
      <% end %>
      <% if @legal_case.pericia_alerta? %>
        <span class="status-pill status-pill--info">Perícia pendente</span>
      <% end %>
    </div>
  </div>

  <div class="health-guidance-grid">
    <article class="health-guidance-card">
      <h4>Por que a saúde está assim?</h4>
      <ul class="health-list">
        <% legal_case_health_reasons(@legal_case).each do |reason| %>
          <li><%= reason %></li>
        <% end %>
      </ul>
    </article>

    <article class="health-guidance-card">
      <h4>O que fazer agora</h4>
      <ul class="health-list">
        <% legal_case_health_actions(@legal_case).each do |action| %>
          <li><%= action %></li>
        <% end %>
      </ul>
    </article>
  </div>
</section>

<div class="case-layout-grid">
  <section class="case-section">
    <h3>Classificação</h3>
    <div class="case-summary__grid">
      <div><strong>Fase:</strong> <span><%= enum_label(LegalCase, :phase, @legal_case.phase) %></span></div>
      <div><strong>Status:</strong> <span><%= enum_label(LegalCase, :status, @legal_case.status) %></span></div>
      <div><strong>Prioridade:</strong> <span><%= enum_label(LegalCase, :priority, @legal_case.priority) %></span></div>
    </div>
  </section>

  <section class="case-section">
    <h3>Dados do Processo</h3>
    <div class="case-summary__grid">
      <div><strong>Valor da causa:</strong> <span><%= @legal_case.claim_value.presence || "-" %></span></div>
      <div><strong>Área:</strong> <span><%= @legal_case.legal_area&.name || "-" %></span></div>
      <div><strong>Tipo:</strong> <span><%= @legal_case.process_type&.name || "-" %></span></div>
      <div><strong>Comarca:</strong> <span><%= @legal_case.district&.name || "-" %></span></div>
      <div><strong>Órgão/Vara/Tribunal:</strong> <span><%= @legal_case.court&.name || "-" %></span></div>
      <div><strong>Parte contrária:</strong> <span><%= @legal_case.opposing_party.presence || "-" %></span></div>
    </div>
  </section>
</div>

<% if @legal_case.tem_pericia? %>
  <section class="case-section">
    <div class="section-head">
      <h3>Perícias do Processo</h3>
      <%= link_to "Nova perícia", new_legal_case_process_exam_path(@legal_case), class: "btn btn-secondary" %>
    </div>

    <% if @process_exams.any? %>
      <div class="exam-cards">
        <% @process_exams.each do |exam| %>
          <article class="exam-card <%= 'exam-card--warning' if exam.near_schedule? %> <%= 'exam-card--danger' if exam.status_laudo_pendente? %>">
            <p><strong>Natureza:</strong> <%= enum_label(ProcessExam, :exam_nature, exam.exam_nature) %></p>
            <p><strong>Esfera:</strong> <%= enum_label(ProcessExam, :exam_scope, exam.exam_scope) %></p>
            <p><strong>Data:</strong> <%= exam.scheduled_label %></p>
            <p><strong>Status:</strong> <%= enum_label(ProcessExam, :status, exam.status) %></p>
            <p><strong>Local:</strong> <%= exam.location.presence || "-" %></p>
            <div class="form-inline-actions">
              <%= link_to "Editar", edit_process_exam_path(exam), class: "btn btn-secondary" %>
              <%= button_to "Excluir", process_exam_path(exam), method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Confirma a exclusão da perícia?" } } %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">Nenhuma perícia cadastrada.</p>
    <% end %>

    <% if @legal_case.observacao_geral_pericia.present? %>
      <p><strong>Observação geral:</strong> <%= @legal_case.observacao_geral_pericia %></p>
    <% end %>
  </section>
<% end %>

<section class="case-section">
  <h3>Situação Atual</h3>
  <div class="case-summary__grid">
    <div><strong>Último andamento:</strong> <span><%= @legal_case.last_movement.presence || "-" %></span></div>
    <div><strong>Data do último andamento:</strong> <span><%= @legal_case.last_movement_at.present? ? l(@legal_case.last_movement_at, format: :short) : "-" %></span></div>
    <div><strong>Próxima providência:</strong> <span><%= @legal_case.next_action.presence || "-" %></span></div>
    <div><strong>Próximo prazo:</strong> <span><%= @legal_case.next_deadline_on.present? ? l(@legal_case.next_deadline_on, format: :short) : "-" %></span></div>
    <div><strong>Responsável atual:</strong> <span><%= @legal_case.responsible_name.presence || "-" %></span></div>
  </div>
</section>

<section class="case-section">
  <div class="section-head">
    <h3>Timeline Unificada</h3>
    <%= link_to "Novo andamento", new_process_movement_path(process_id: @legal_case.id), class: "btn btn-secondary" %>
  </div>

  <% if @timeline_items.any? %>
    <div class="timeline-list">
      <% @timeline_items.each do |item| %>
        <article class="timeline-item <%= item[:highlight] ? 'timeline-item--highlight' : 'timeline-item--soft' %>">
          <div class="timeline-meta">
            <span class="status-pill"><%= item[:source] == :process_movement ? "Andamento" : "Legado" %></span>
            <% if item[:nature].present? %>
              <span class="status-pill status-pill--muted"><%= item[:nature].to_s.humanize %></span>
            <% end %>
            <% if item[:administrative_situation].present? %>
              <span class="status-pill status-pill--info"><%= enum_label(ProcessMovement, :administrative_situation, item[:administrative_situation]) %></span>
            <% end %>
          </div>
          <h4><%= item[:title] %></h4>
          <p class="timeline-subline">
            <strong>Data:</strong> <%= item[:date].present? ? l(item[:date], format: :short) : "-" %>
            | <strong>Tipo:</strong> <%= item[:movement_type].presence || "-" %>
            | <strong>Origem:</strong> <%= item[:origin].to_s.humanize %>
          </p>
          <% if item[:exam].present? %>
            <p><strong>Perícia vinculada:</strong> <%= item[:exam].summary_label %></p>
          <% end %>
          <% if item[:description].present? %>
            <p><%= item[:description] %></p>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="empty-state">Nenhum andamento cadastrado.</p>
  <% end %>
</section>

<section class="case-section">
  <div class="section-head">
    <h3>Prazos</h3>
    <%= link_to "Novo prazo", new_deadline_path(legal_case_id: @legal_case.id), class: "btn btn-secondary" %>
  </div>

  <% if @deadlines.any? %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Título</th>
            <th>Tipo</th>
            <th>Data final</th>
            <th>Status</th>
            <th>Prioridade</th>
          </tr>
        </thead>
        <tbody>
          <% @deadlines.each do |deadline| %>
            <tr>
              <td><%= deadline.title %></td>
              <td><%= enum_label(Deadline, :deadline_type, deadline.deadline_type) %></td>
              <td><%= deadline.due_date %></td>
              <td><%= enum_label(Deadline, :status, deadline.status) %></td>
              <td><%= enum_label(Deadline, :priority, deadline.priority) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="empty-state">Nenhum prazo cadastrado.</p>
  <% end %>
</section>

<section class="case-section">
  <div class="section-head">
    <h3>Tarefas</h3>
    <%= link_to "Nova tarefa", new_task_path(legal_case_id: @legal_case.id), class: "btn btn-secondary" %>
  </div>

  <% if @tasks.any? %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Título</th>
            <th>Responsável</th>
            <th>Data limite</th>
            <th>Status</th>
            <th>Prioridade</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <tr>
              <td><%= task.title %></td>
              <td><%= task.responsible_name.presence || "-" %></td>
              <td><%= task.due_date %></td>
              <td><%= enum_label(Task, :status, task.status) %></td>
              <td><%= enum_label(Task, :priority, task.priority) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="empty-state">Nenhuma tarefa cadastrada.</p>
  <% end %>
</section>

<div class="case-actions case-actions--footer">
  <%= link_to "Editar processo", edit_legal_case_path(@legal_case), class: "btn btn-secondary" %>
  <%= link_to "Voltar", legal_cases_path, class: "btn btn-secondary" %>
  <%= button_to "Excluir processo", @legal_case, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Tem certeza que deseja excluir este processo?" } } %>
</div>
