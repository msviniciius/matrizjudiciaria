<% content_for :title, "Configurações do Escritório" %>

<%= form_with model: @office, url: office_setting_path, method: :patch, class: "app-form office-settings-form", data: { office_settings_form: true } do |form| %>
  <% if @office.errors.any? %>
    <div class="form-errors">
      <h2>Foram encontrados <%= pluralize(@office.errors.count, "erro", "erros") %>:</h2>
      <ul>
        <% @office.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="case-section office-settings-shell">
    <div class="office-settings-top">
      <div>
        <h3>Configurações do Escritório</h3>
        <p class="form-hint">Edite dados institucionais, regras operacionais e integrações em um só lugar.</p>
      </div>
      <div class="office-settings-status" data-office-settings-status>
        <span class="status-pill status-pill--success" data-office-settings-clean>Sem alterações pendentes</span>
        <span class="status-pill status-pill--warning" data-office-settings-dirty hidden>Alterações não salvas</span>
      </div>
    </div>

    <div class="office-settings-layout" data-office-settings-tabs>
      <aside class="office-settings-nav" role="tablist" aria-label="Seções de configurações">
        <button type="button" class="office-settings-nav__item is-active" data-office-tab="identidade" aria-selected="true">Identidade</button>
        <button type="button" class="office-settings-nav__item" data-office-tab="operacional" aria-selected="false">Regras operacionais</button>
        <button type="button" class="office-settings-nav__item" data-office-tab="integracoes" aria-selected="false">Integrações</button>
        <button type="button" class="office-settings-nav__item" data-office-tab="equipe" aria-selected="false">Equipe e acessos</button>
      </aside>

      <div class="office-settings-content">
        <section class="form-section office-tab-panel is-active" data-office-panel="identidade" role="tabpanel">
          <div class="section-head-actions">
            <h3>Identidade do Escritório</h3>
            <span class="form-hint">Dados públicos e visuais da conta.</span>
          </div>
          <div class="form-grid">
            <div>
              <%= form.label :name, "Nome do escritório" %>
              <%= form.text_field :name, required: true, data: { office_preview_name: true } %>
            </div>

            <div>
              <%= form.label :legal_name, "Razão social" %>
              <%= form.text_field :legal_name %>
            </div>

            <div>
              <%= form.label :cnpj, "CNPJ" %>
              <%= form.text_field :cnpj, data: { mask: "cnpj" }, inputmode: "numeric" %>
            </div>

            <div>
              <%= form.label :oab_registration, "Registro OAB" %>
              <%= form.text_field :oab_registration %>
            </div>

            <div>
              <%= form.label :email, "E-mail do escritório" %>
              <%= form.email_field :email %>
            </div>

            <div>
              <%= form.label :phone, "Telefone" %>
              <%= form.text_field :phone, data: { mask: "phone" }, inputmode: "numeric" %>
            </div>

            <div class="field-full">
              <%= form.label :zip_code, "CEP" %>
              <%= form.text_field :zip_code, data: { mask: "cep", cep_lookup: true }, inputmode: "numeric" %>
            </div>

            <div class="field-full">
              <%= form.label :address, "Endereço" %>
              <%= form.text_field :address, data: { cep_lookup_street: true } %>
            </div>

            <div>
              <%= form.label :city, "Cidade" %>
              <%= form.text_field :city, data: { cep_lookup_city: true } %>
            </div>

            <div>
              <%= form.label :state, "UF" %>
              <%= form.text_field :state, data: { cep_lookup_state: true, mask: "uf" }, inputmode: "text" %>
            </div>

            <div>
              <%= form.label :slug, "Identificador" %>
              <%= form.text_field :slug, disabled: true %>
            </div>

            <div>
              <%= form.label :primary_color, "Cor primária" %>
              <%= form.color_field :primary_color, data: { office_preview_primary: true } %>
            </div>

            <div>
              <%= form.label :secondary_color, "Cor secundária" %>
              <%= form.color_field :secondary_color, data: { office_preview_secondary: true } %>
            </div>

            <div class="field-full">
              <%= form.label :logo, "Logotipo" %>
              <%= form.file_field :logo, accept: "image/png,image/jpeg,image/webp,image/svg+xml" %>
            </div>

            <% if @office.logo_attached? %>
              <div class="field-full office-logo-preview">
                <%= image_tag url_for(@office.logo), alt: @office.name %>
                <label class="checkbox-field">
                  <%= check_box_tag "office[remove_logo]", "1", false %>
                  <span>Remover logotipo atual</span>
                </label>
              </div>
            <% end %>
          </div>
        </section>

        <section class="form-section office-tab-panel" data-office-panel="operacional" role="tabpanel" hidden>
          <div class="section-head-actions">
            <h3>Regras Operacionais</h3>
            <span class="form-hint">Padrões automáticos para novos processos e alertas.</span>
          </div>
          <div class="form-grid">
            <div>
              <%= form.label :default_phase, "Fase padrão em novo processo" %>
              <%= form.select :default_phase, enum_options_for(LegalCase, :phase) %>
            </div>

            <div>
              <%= form.label :default_status, "Status padrão em novo processo" %>
              <%= form.select :default_status, enum_options_for(LegalCase, :status) %>
            </div>

            <div>
              <%= form.label :default_priority, "Prioridade padrão em novo processo" %>
              <%= form.select :default_priority, enum_options_for(LegalCase, :priority) %>
            </div>

            <div>
              <%= form.label :deadline_alert_days, "Dias de alerta para prazos" %>
              <%= form.number_field :deadline_alert_days, min: 0, max: 60 %>
            </div>

            <div>
              <%= form.label :task_alert_days, "Dias de alerta para tarefas" %>
              <%= form.number_field :task_alert_days, min: 0, max: 60 %>
            </div>
          </div>
        </section>

        <section class="form-section office-tab-panel" data-office-panel="integracoes" role="tabpanel" hidden>
          <div class="section-head-actions">
            <h3>Integrações</h3>
            <span class="form-hint">Escolha os tribunais habilitados para sincronização.</span>
          </div>
          <%= hidden_field_tag "office[enabled_tribunals][]", "" %>
          <div class="checkbox-group office-integrations-grid" data-office-integrations-group>
            <% Office::TRIBUNAL_INTEGRATIONS.each do |label, code| %>
              <label class="checkbox-field office-integration-option">
                <%= check_box_tag "office[enabled_tribunals][]", code, @office.enabled_tribunal_codes.include?(code), id: "office_enabled_tribunals_#{code}" %>
                <span class="office-integration-option__content">
                  <strong><%= label %></strong>
                  <small><%= code.upcase %></small>
                </span>
              </label>
            <% end %>
          </div>
          <p class="form-hint">Tribunais habilitados: <strong data-office-integrations-count><%= @office.enabled_tribunal_codes.count %></strong></p>
        </section>

        <section class="form-section office-tab-panel" data-office-panel="equipe" role="tabpanel" hidden>
          <div class="section-head-actions">
            <h3>Equipe e Acessos</h3>
            <%= link_to "Novo usuário", new_office_setting_user_path, class: "btn btn-secondary" %>
          </div>

          <div class="table-wrap office-users-table">
            <table>
              <thead>
                <tr>
                  <th>Nome</th>
                  <th>E-mail</th>
                  <th>Tipo</th>
                  <th>Status</th>
                  <th class="actions-col">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% if @users.any? %>
                  <% @users.each do |user| %>
                    <tr>
                      <td><%= user.name %></td>
                      <td><%= user.email %></td>
                      <td><%= user.role_label %></td>
                      <td><%= user.active? ? "Ativo" : "Inativo" %></td>
                      <td class="table-actions office-users-actions">
                        <%= link_to edit_office_setting_user_path(user), class: "btn btn-secondary btn-icon", aria: { label: "Editar usuário" }, title: "Editar usuário" do %>
                          <span aria-hidden="true">&#9998;</span>
                        <% end %>
                        <% unless user == current_user %>
                          <%= button_to office_setting_user_path(user), method: :delete, class: "btn btn-secondary btn-icon", data: { turbo_confirm: "Excluir este usuário?" }, aria: { label: "Excluir usuário" }, title: "Excluir usuário" do %>
                            <span aria-hidden="true">&#128465;</span>
                          <% end %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="table-empty-state">Nenhum usuário cadastrado.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <aside class="office-settings-preview">
        <article class="office-preview-card">
          <p class="office-preview-kicker">Pré-visualização</p>
          <h4 data-office-preview-name><%= @office.name.presence || "Nome do escritório" %></h4>
          <div class="office-preview-swatches">
            <span data-office-preview-primary style="background: <%= @office.primary_color %>;"></span>
            <span data-office-preview-secondary style="background: <%= @office.secondary_color %>;"></span>
          </div>
          <p class="form-hint">As cores acima representam a identidade visual aplicada no sistema.</p>
        </article>
      </aside>
    </div>
  </section>

  <div class="form-actions office-settings-actions">
    <%= link_to "Voltar", root_path, class: "btn btn-secondary" %>
    <%= form.submit "Salvar configurações", class: "btn btn-primary" %>
  </div>
<% end %>
