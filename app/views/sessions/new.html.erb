<% content_for :title, "Login" %>

<section class="auth-shell">
  <div class="auth-card">
    <div class="auth-card__form">
      <p class="auth-kicker">Matriz Jurídica</p>
      <h1>Entrar na plataforma</h1>
      <p class="auth-subtitle">Acesse com e-mail e senha para entrar no ambiente do seu escritório.</p>

      <%= form_with url: login_path, method: :post, class: "auth-form", local: true do |form| %>
        <div>
          <%= form.label :email, "E-mail" %>
          <%= form.email_field :email, required: true, autocomplete: "email" %>
        </div>

        <div>
          <%= form.label :password, "Senha" %>
          <div class="password-field">
            <%= form.password_field :password, id: "login_password", required: true, autocomplete: "current-password" %>
            <button
              type="button"
              class="password-field__toggle"
              data-password-toggle
              data-password-target="login_password"
              aria-label="Mostrar senha"
              title="Mostrar senha"
            >
              <span data-password-icon aria-hidden="true">&#128065;</span>
            </button>
          </div>
        </div>

        <%= form.submit "Entrar", class: "btn btn-primary btn-block" %>
      <% end %>
    </div>

    <div class="auth-card__brand">
      <div class="auth-card__brand-box">
        <% if office_logo_url.present? %>
          <%= image_tag office_logo_url, alt: law_firm_name, class: "auth-logo" %>
        <% else %>
          <span class="auth-logo-placeholder" aria-hidden="true">&#9878;</span>
        <% end %>
        <h2><%= law_firm_name %></h2>
        <p>Gestão Processual</p>
      </div>
    </div>
  </div>
</section>
