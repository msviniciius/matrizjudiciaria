<% content_for :title, @process_movement.display_title %>

<section class="case-section">
  <h3>Detalhes do andamento</h3>
  <div class="table-wrap details-table">
    <table>
      <tbody>
        <tr><th>Processo</th><td><%= @process_movement.process&.internal_number || "-" %></td></tr>
        <tr><th>Fase</th><td><%= @process_movement.phase&.name || "-" %></td></tr>
        <tr><th>Tipo</th><td><%= @process_movement.movement_type&.name || "-" %></td></tr>
        <tr><th>Natureza</th><td><%= enum_label(ProcessMovement, :nature, @process_movement.nature) %></td></tr>
        <tr><th>Impacto</th><td><%= enum_label(ProcessMovement, :impact, @process_movement.impact) %></td></tr>
        <tr><th>Origem</th><td><%= enum_label(ProcessMovement, :origin, @process_movement.origin) %></td></tr>
        <tr><th>Situação administrativa</th><td><%= @process_movement.administrative_situation.present? ? enum_label(ProcessMovement, :administrative_situation, @process_movement.administrative_situation) : "-" %></td></tr>
        <tr><th>Data</th><td><%= l(@process_movement.event_date, format: :short) %></td></tr>
        <tr><th>Descrição</th><td><%= @process_movement.complementary_description.presence || "-" %></td></tr>
      </tbody>
    </table>
  </div>
</section>

<section class="case-section">
  <h3>Auditoria</h3>
  <% if @process_movement.audits.any? %>
    <div class="timeline-list">
      <% @process_movement.audits.order(created_at: :desc).each do |audit| %>
        <article class="timeline-item timeline-item--soft">
          <h4><%= audit.action.humanize %></h4>
          <p class="timeline-subline"><strong>Data:</strong> <%= l(audit.created_at, format: :short) %></p>
          <p><strong>Justificativa:</strong> <%= audit.justification.presence || "-" %></p>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="empty-state">Sem registros de auditoria.</p>
  <% end %>
</section>

<div class="case-actions case-actions--footer">
  <%= link_to "Editar", edit_process_movement_path(@process_movement), class: "btn btn-secondary" %>
  <%= link_to "Voltar", process_movements_path, class: "btn btn-secondary" %>
  <%= button_to "Excluir", @process_movement, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Confirma a exclusão?" } } %>
</div>
