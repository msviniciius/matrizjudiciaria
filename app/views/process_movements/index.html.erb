<% content_for :title, "Andamentos Processuais" %>

<% content_for :topbar_actions do %>
  <%= link_to "Novo andamento", new_process_movement_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section">
  <%= form_with url: process_movements_path, method: :get, local: true, class: "main-filters", data: { main_filters: true, filters_open: @advanced_filters_open } do |form| %>
    <div class="main-filters__bar">
      <button
        type="button"
        class="main-filters__toggle"
        data-main-filters-toggle
        aria-expanded="<%= @advanced_filters_open ? 'true' : 'false' %>"
      >
        <span aria-hidden="true"><%= @advanced_filters_open ? "▾" : "▸" %></span>
        Filtrar
      </button>

      <%= form.text_field :q, value: @filters[:q], placeholder: "Processo, título, descrição ou responsável", class: "main-filters__q" %>

      <%= form.submit "Buscar", class: "main-filters__submit" %>
    </div>

    <div class="main-filters__advanced <%= "is-open" if @advanced_filters_open %>" data-main-filters-advanced>
      <div class="form-grid">
      <div>
        <%= form.label :phase_id, "Fase" %>
        <%= form.collection_select :phase_id, ProcessPhase.where(active: true).order(:order, :name), :id, :name, { include_blank: "Todas" }, { value: @filters[:phase_id] } %>
      </div>
      <div>
        <%= form.label :status, "Status" %>
        <%= form.select :status, enum_options_for(LegalCase, :status), { include_blank: "Todos", selected: @filters[:status] } %>
      </div>
      <div>
        <%= form.label :movement_type_id, "Tipo" %>
        <%= form.collection_select :movement_type_id, MovementType.where(active: true).order(:name), :id, :name, { include_blank: "Todos", selected: @filters[:movement_type_id] } %>
      </div>
      <div>
        <%= form.label :nature, "Natureza" %>
        <%= form.select :nature, enum_options_for(ProcessMovement, :nature), { include_blank: "Todas", selected: @filters[:nature] } %>
      </div>
      <div>
        <%= form.label :impact, "Impacto" %>
        <%= form.select :impact, enum_options_for(ProcessMovement, :impact), { include_blank: "Todos", selected: @filters[:impact] } %>
      </div>
      <div>
        <%= form.label :origin, "Origem" %>
        <%= form.select :origin, enum_options_for(ProcessMovement, :origin), { include_blank: "Todas", selected: @filters[:origin] } %>
      </div>
      <div>
        <%= form.label :from, "Período de" %>
        <%= form.date_field :from, value: @filters[:from] %>
      </div>
      <div>
        <%= form.label :to, "Período até" %>
        <%= form.date_field :to, value: @filters[:to] %>
      </div>
      <div>
        <%= form.label :responsible_name, "Responsável" %>
        <%= form.text_field :responsible_name, value: @filters[:responsible_name] %>
      </div>
      <div>
        <%= form.label :exam_id, "Perícia" %>
        <%= form.collection_select :exam_id, ProcessExam.joins(:legal_case).where(legal_cases: { office_id: current_office.id }).where(active: true).order(:scheduled_at), :id, :summary_label, { include_blank: "Todas", selected: @filters[:exam_id] } %>
      </div>
      <div>
        <%= form.label :administrative_situation, "Situação administrativa" %>
        <%= form.select :administrative_situation, enum_options_for(ProcessMovement, :administrative_situation), { include_blank: "Todas", selected: @filters[:administrative_situation] } %>
      </div>
    </div>

      <div class="form-actions">
        <%= link_to "Limpar filtros", process_movements_path, class: "btn btn-secondary" %>
        <%= form.submit "Buscar", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</section>

<section class="case-section">
  <h3>Relatórios</h3>
  <div class="report-grid">
    <article class="report-card">
      <p class="report-label">Por fase</p>
      <p class="report-value"><%= @reports[:por_fase].values.sum %></p>
    </article>
    <article class="report-card">
      <p class="report-label">Por tipo</p>
      <p class="report-value"><%= @reports[:por_tipo].values.sum %></p>
    </article>
    <article class="report-card">
      <p class="report-label">Por natureza</p>
      <p class="report-value"><%= @reports[:por_natureza].values.sum %></p>
    </article>
    <article class="report-card">
      <p class="report-label">Por impacto</p>
      <p class="report-value"><%= @reports[:por_impacto].values.sum %></p>
    </article>
  </div>
</section>

<section class="case-section case-section--listing">
  <div class="listing-head">
    <h3>Listagem</h3>
    <p>Exibindo <strong><%= @process_movements.size %></strong> andamento(s)</p>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Processo</th>
          <th>Fase</th>
          <th>Status</th>
          <th>Tipo</th>
          <th>Título</th>
          <th>Data</th>
          <th>Situação Adm.</th>
          <th class="actions-col">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @process_movements.any? %>
          <% @process_movements.each do |movement| %>
            <tr>
              <td>
                <% if movement.process.present? %>
                  <%= link_to movement.process.internal_number, legal_case_path(movement.process) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td><%= movement.phase&.name %></td>
              <td><%= movement.process&.status.present? ? enum_label(LegalCase, :status, movement.process.status) : "-" %></td>
              <td><%= movement.movement_type&.name %></td>
              <td><%= movement.display_title %></td>
              <td><%= l(movement.event_date, format: :short) %></td>
              <td><%= movement.administrative_situation.present? ? enum_label(ProcessMovement, :administrative_situation, movement.administrative_situation) : "-" %></td>
              <td class="table-actions">
                <%= link_to movement, class: "btn btn-secondary btn-icon", aria: { label: "Ver andamento processual" }, title: "Ver andamento processual" do %>
                  <span aria-hidden="true">&#128065;</span>
                <% end %>
                <%= link_to edit_process_movement_path(movement), class: "btn btn-secondary btn-icon", aria: { label: "Editar andamento processual" }, title: "Editar andamento processual" do %>
                  <span aria-hidden="true">&#9998;</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="table-empty-state">Nenhum andamento processual cadastrado.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
