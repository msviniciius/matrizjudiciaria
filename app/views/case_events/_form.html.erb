<% back_path = local_assigns[:back_path] %>
<% show_path = local_assigns[:show_path] %>
<% show_label = local_assigns[:show_label] || "Ver" %>

<%= form_with(model: case_event, class: "app-form") do |form| %>
  <% if case_event.errors.any? %>
    <div class="form-errors">
      <h2>Foram encontrados <%= pluralize(case_event.errors.count, "erro", "erros") %> neste cadastro:</h2>
      <ul>
        <% case_event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="form-section">
    <h3>Andamento Processual</h3>
    <p class="helper-text">Registre fatos relevantes do caso. Use <strong>nota interna</strong> ou <strong>atualização estratégica</strong> quando não for um andamento processual.</p>

    <div class="form-grid">
      <div class="field-full">
        <%= form.label :legal_case_id, "Processo" %>
        <%= form.collection_select :legal_case_id, current_office.legal_cases.includes(:client).order(:internal_number), :id, :display_number_and_client, { prompt: "Selecione o processo" } %>
      </div>

      <div>
        <%= form.label :entry_kind, "Tipo de registro" %>
        <%= form.select :entry_kind, enum_options_for(CaseEvent, :entry_kind), {}, data: { entry_kind_select: true } %>
      </div>

      <div data-movement-type-field>
        <%= form.label :movement_type_id, "Tipo de andamento" %>
        <%= form.collection_select :movement_type_id, MovementType.where(active: true).order(:name), :id, :name, { include_blank: "Selecione a categoria" }, data: { movement_type_select: true } %>
      </div>

      <div>
        <%= form.label :event_type, "Evento" %>
        <%= form.select :event_type, enum_options_for(CaseEvent, :event_type) %>
      </div>

      <div>
        <%= form.label :occurred_at, "Data e hora do evento" %>
        <%= form.datetime_field :occurred_at %>
      </div>

      <div class="field-full">
        <p class="form-hint">
          Fase após o registro: definida automaticamente pelo <strong>tipo de andamento</strong>.
          Status após o registro: definido automaticamente pelo <strong>evento</strong>.
        </p>
      </div>

      <div class="field-full">
        <%= form.label :next_action, "Próxima providência" %>
        <%= form.text_field :next_action %>
      </div>

      <div class="field-full">
        <%= form.label :responsible_name, "Responsável pelo registro" %>
        <%= form.text_field :responsible_name %>
      </div>
    </div>
  </section>

  <section class="form-section">
    <h3>Descrição do Fato</h3>
    <div class="form-grid">
      <div class="field-full">
        <%= form.label :description, "Descrição" %>
        <%= form.textarea :description %>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <% if back_path.present? %>
      <%= link_to "Voltar", back_path, class: "btn btn-secondary" %>
    <% end %>
    <% if show_path.present? %>
      <%= link_to show_label, show_path, class: "btn btn-secondary" %>
    <% end %>
    <%= form.submit %>
  </div>
<% end %>
