<%= form_with(model: case_event, class: "app-form") do |form| %>
  <% if case_event.errors.any? %>
    <div class="form-errors">
      <h2>Foram encontrados <%= pluralize(case_event.errors.count, "erro", "erros") %> neste cadastro:</h2>
      <ul>
        <% case_event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="form-section">
    <h3>Dados do Andamento</h3>
    <div class="form-grid">
      <div class="field-full">
        <%= form.label :legal_case_id %>
        <%= form.collection_select :legal_case_id, LegalCase.order(:internal_number), :id, :internal_number, prompt: "Selecione o processo" %>
      </div>

      <div>
        <%= form.label :event_type %>
        <%= form.select :event_type, enum_options_for(CaseEvent, :event_type) %>
      </div>

      <div>
        <%= form.label :occurred_at %>
        <%= form.datetime_field :occurred_at %>
      </div>

      <div class="field-full">
        <%= form.label :responsible_name %>
        <%= form.text_field :responsible_name %>
      </div>
    </div>
  </section>

  <section class="form-section">
    <h3>Descrição do Evento</h3>
    <div class="form-grid">
      <div class="field-full">
        <%= form.label :description %>
        <%= form.textarea :description %>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <%= form.submit %>
  </div>
<% end %>
