<div id="<%= dom_id case_event %>">
  <div>
    <strong>Processo:</strong>
    <%= case_event.legal_case&.internal_number %>
  </div>

  <div>
    <strong>Tipo de registro:</strong>
    <%= enum_label(CaseEvent, :entry_kind, case_event.entry_kind) %>
  </div>

  <div>
    <strong>Categoria:</strong>
    <%= case_event.movement_type&.name || "-" %>
  </div>

  <div>
    <strong>Perícia vinculada:</strong>
    <%= case_event.process_exam&.summary_label || "-" %>
  </div>

  <div>
    <strong>Próxima providência:</strong>
    <%= case_event.next_action.presence || "-" %>
  </div>

  <div>
    <strong>Responsável:</strong>
    <%= case_event.responsible_name.presence || "-" %>
  </div>

  <div>
    <strong>Descrição:</strong>
    <%= case_event.description %>
  </div>
</div>
