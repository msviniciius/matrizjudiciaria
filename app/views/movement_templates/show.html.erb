<% content_for :title, @movement_template.name %>

<section class="case-section">
  <h3>Detalhes do modelo</h3>
  <div class="table-wrap details-table">
    <table>
      <tbody>
        <tr><th>Código</th><td><%= @movement_template.code %></td></tr>
        <tr><th>Nome</th><td><%= @movement_template.name %></td></tr>
        <tr><th>Fase</th><td><%= @movement_template.phase&.name || "-" %></td></tr>
        <tr><th>Tipo</th><td><%= @movement_template.movement_type&.name || "-" %></td></tr>
        <tr><th>Natureza padrão</th><td><%= enum_label(MovementTemplate, :nature_default, @movement_template.nature_default) %></td></tr>
        <tr><th>Impacto padrão</th><td><%= enum_label(MovementTemplate, :impact_default, @movement_template.impact_default) %></td></tr>
        <tr><th>Descrição</th><td><%= @movement_template.short_description.presence || "-" %></td></tr>
      </tbody>
    </table>
  </div>
</section>

<div class="case-actions case-actions--footer">
  <%= link_to "Editar", edit_movement_template_path(@movement_template), class: "btn btn-secondary" %>
  <%= link_to "Voltar", movement_templates_path, class: "btn btn-secondary" %>
  <%= button_to "Excluir", @movement_template, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Confirma a exclusão?" } } %>
</div>
