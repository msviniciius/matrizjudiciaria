<% content_for :title, @movement_template.name %>

<p><strong>Código:</strong> <%= @movement_template.code %></p>
<p><strong>Fase:</strong> <%= @movement_template.phase&.name %></p>
<p><strong>Tipo:</strong> <%= @movement_template.movement_type&.name %></p>
<p><strong>Natureza padrão:</strong> <%= enum_label(MovementTemplate, :nature_default, @movement_template.nature_default) %></p>
<p><strong>Impacto padrão:</strong> <%= enum_label(MovementTemplate, :impact_default, @movement_template.impact_default) %></p>
<p><strong>Descrição:</strong> <%= @movement_template.short_description.presence || "-" %></p>

<div class="case-actions case-actions--footer">
  <%= link_to "Editar", edit_movement_template_path(@movement_template), class: "btn btn-secondary" %>
  <%= link_to "Voltar", movement_templates_path, class: "btn btn-secondary" %>
  <%= button_to "Excluir", @movement_template, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Confirma a exclusão?" } } %>
</div>
