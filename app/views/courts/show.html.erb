<% content_for :title, "Órgão/Vara/Tribunal" %>

<section class="case-section">
  <h3>Detalhes</h3>
  <div class="table-wrap details-table">
    <table>
      <tbody>
        <tr>
          <th>Nome</th>
          <td><%= @court.name %></td>
        </tr>
        <tr>
          <th>Comarca</th>
          <td><%= @court.district&.name || "-" %></td>
        </tr>
        <tr>
          <th>Processos vinculados</th>
          <td><%= @court.legal_cases.count %></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<div class="case-actions case-actions--footer">
  <%= link_to "Editar", edit_court_path(@court), class: "btn btn-secondary" %>
  <%= link_to "Voltar", courts_path, class: "btn btn-secondary" %>
  <%= button_to "Excluir", @court, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Confirma a exclusão?" } } %>
</div>
