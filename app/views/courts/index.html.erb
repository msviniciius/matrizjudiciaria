<% content_for :title, "Órgãos/Vara/Tribunal" %>

<% content_for :topbar_actions do %>
  <%= link_to "Novo órgão/vara/tribunal", new_court_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Comarca</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @courts.any? %>
          <% @courts.each do |court| %>
            <tr>
              <td><%= court.name %></td>
              <td><%= court.district&.name || "-" %></td>
              <td>
                <div class="table-actions">
                  <%= link_to "Editar", edit_court_path(court), class: "btn btn-secondary" %>
                  <%= button_to "Excluir", court, method: :delete, class: "btn btn-danger", form: { class: "table-action-form", data: { turbo_confirm: "Excluir este órgão/vara/tribunal?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="3" class="table-empty-state">Nenhum órgão/vara/tribunal cadastrado.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
