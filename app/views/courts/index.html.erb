<% content_for :title, "Órgãos/Vara/Tribunal" %>

<% content_for :topbar_actions do %>
  <%= link_to "Novo órgão/vara/tribunal", new_court_path, class: "btn btn-primary" %>
<% end %>

<section class="case-section">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Comarca</th>
          <th class="actions-col">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @courts.any? %>
          <% @courts.each do |court| %>
            <tr>
              <td><%= court.name %></td>
              <td><%= court.district&.name || "-" %></td>
              <td class="table-actions">
                <%= link_to edit_court_path(court), class: "btn btn-secondary btn-icon", aria: { label: "Editar órgão/vara/tribunal" }, title: "Editar órgão/vara/tribunal" do %>
                  <span aria-hidden="true">&#9998;</span>
                <% end %>
                <%= button_to court, method: :delete, class: "btn btn-danger btn-icon", form: { class: "table-action-form", data: { turbo_confirm: "Excluir este órgão/vara/tribunal?" } }, aria: { label: "Excluir órgão/vara/tribunal" }, title: "Excluir órgão/vara/tribunal" do %>
                  <span aria-hidden="true">&#128465;</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="3" class="table-empty-state">Nenhum órgão/vara/tribunal cadastrado.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
