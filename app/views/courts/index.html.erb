<% content_for :title, "Órgãos/Vara/Tribunal" %>

<section class="case-section">
  <div class="section-head">
    <h3>Órgãos/Vara/Tribunal</h3>
    <%= link_to "Novo órgão/vara/tribunal", new_court_path, class: "btn btn-secondary" %>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Comarca</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @courts.each do |court| %>
          <tr>
            <td><%= court.name %></td>
            <td><%= court.district&.name || "-" %></td>
            <td>
              <%= link_to "Editar", edit_court_path(court) %>
              <%= button_to "Excluir", court, method: :delete, form: { data: { turbo_confirm: "Excluir este órgão/vara/tribunal?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
