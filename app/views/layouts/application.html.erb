<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Matrizjuridica" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Matrizjuridica">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag :app, "data-turbo-track": "reload", defer: true %>
  </head>

  <body style="<%= office_theme_css_variables %>">
    <div class="app-background"></div>

    <div class="app-layout" data-sidebar-layout>
      <aside class="app-sidebar">
        <div class="app-sidebar__brand">
          <span class="app-sidebar__brand-mark" aria-hidden="true">&#9878;</span>
          <span class="app-sidebar__brand-name"><%= app_product_name %></span>
        </div>

        <div class="brand">
          <p class="brand-eyebrow"><%= app_context_name %></p>
          <h1><%= law_firm_name %></h1>
        </div>

        <nav class="sidebar-nav" data-sidebar-sections>
          <section class="sidebar-section is-open" data-sidebar-section="operacao">
            <button
              type="button"
              class="sidebar-section__toggle"
              data-sidebar-section-toggle
              aria-expanded="true"
              aria-controls="sidebar-section-operacao"
              aria-label="Operação"
              title="Operação"
            >
              <span class="sidebar-section__icon" aria-hidden="true">&#9878;</span>
              <span class="sidebar-section__title">Operação</span>
              <span class="sidebar-section__chevron" aria-hidden="true">&#9662;</span>
            </button>

            <div class="sidebar-section__body" id="sidebar-section-operacao">
              <%= link_to painel_path, class: "nav-link #{'is-active' if controller_name == 'dashboard'}", aria: { label: "Painel" }, title: "Painel" do %>
                <span class="nav-link__icon" aria-hidden="true">&#8962;</span>
                <span class="nav-link__label">Painel</span>
              <% end %>

              <%= link_to clients_path, class: "nav-link #{'is-active' if controller_name == 'clients'}", aria: { label: "Clientes" }, title: "Clientes" do %>
                <span class="nav-link__icon" aria-hidden="true">&#128101;</span>
                <span class="nav-link__label">Clientes</span>
              <% end %>

              <%= link_to legal_cases_path, class: "nav-link #{'is-active' if controller_name == 'legal_cases'}", aria: { label: "Processos" }, title: "Processos" do %>
                <span class="nav-link__icon" aria-hidden="true">&#128194;</span>
                <span class="nav-link__label">Processos</span>
              <% end %>

              <%= link_to case_events_path, class: "nav-link #{'is-active' if controller_name == 'case_events'}", aria: { label: "Andamentos" }, title: "Andamentos" do %>
                <span class="nav-link__icon" aria-hidden="true">&#128221;</span>
                <span class="nav-link__label">Andamentos</span>
              <% end %>

              <%= link_to deadlines_path, class: "nav-link #{'is-active' if controller_name == 'deadlines'}", aria: { label: "Prazos" }, title: "Prazos" do %>
                <span class="nav-link__icon" aria-hidden="true">&#9200;</span>
                <span class="nav-link__label">Prazos</span>
              <% end %>

              <%= link_to tasks_path, class: "nav-link #{'is-active' if controller_name == 'tasks'}", aria: { label: "Tarefas" }, title: "Tarefas" do %>
                <span class="nav-link__icon" aria-hidden="true">&#10003;</span>
                <span class="nav-link__label">Tarefas</span>
              <% end %>
            </div>
          </section>

          <section class="sidebar-section is-open" data-sidebar-section="cadastros">
            <button
              type="button"
              class="sidebar-section__toggle"
              data-sidebar-section-toggle
              aria-expanded="true"
              aria-controls="sidebar-section-cadastros"
              aria-label="Cadastros"
              title="Cadastros"
            >
              <span class="sidebar-section__icon" aria-hidden="true">&#128451;</span>
              <span class="sidebar-section__title">Cadastros</span>
              <span class="sidebar-section__chevron" aria-hidden="true">&#9662;</span>
            </button>

            <div class="sidebar-section__body" id="sidebar-section-cadastros">
              <%= link_to deadline_settings_path, class: "nav-link #{'is-active' if controller_name == 'deadline_settings'}", aria: { label: "Cadastro de prazos" }, title: "Cadastro de prazos" do %>
                <span class="nav-link__icon" aria-hidden="true">&#128197;</span>
                <span class="nav-link__label">Cadastro de prazos</span>
              <% end %>

              <%= link_to courts_path, class: "nav-link #{'is-active' if controller_name == 'courts'}", aria: { label: "Órgãos/Varas" }, title: "Órgãos/Varas" do %>
                <span class="nav-link__icon" aria-hidden="true">&#9873;</span>
                <span class="nav-link__label">Órgãos/Varas</span>
              <% end %>

              <%= link_to districts_path, class: "nav-link #{'is-active' if controller_name == 'districts'}", aria: { label: "Comarcas" }, title: "Comarcas" do %>
                <span class="nav-link__icon" aria-hidden="true">&#128205;</span>
                <span class="nav-link__label">Comarcas</span>
              <% end %>
            </div>
          </section>

          <section class="sidebar-section is-open" data-sidebar-section="configuracoes">
            <button
              type="button"
              class="sidebar-section__toggle"
              data-sidebar-section-toggle
              aria-expanded="true"
              aria-controls="sidebar-section-configuracoes"
              aria-label="Configurações"
              title="Configurações"
            >
              <span class="sidebar-section__icon" aria-hidden="true">&#9881;</span>
              <span class="sidebar-section__title">Configurações</span>
              <span class="sidebar-section__chevron" aria-hidden="true">&#9662;</span>
            </button>

            <div class="sidebar-section__body" id="sidebar-section-configuracoes">
              <% if current_user&.admin? %>
                <%= link_to edit_office_setting_path, class: "nav-link #{'is-active' if %w[office_settings office_users].include?(controller_name)}", aria: { label: "Escritório" }, title: "Escritório" do %>
                  <span class="nav-link__icon" aria-hidden="true">&#9881;</span>
                  <span class="nav-link__label">Escritório</span>
                <% end %>
              <% end %>
            </div>
          </section>
        </nav>
      </aside>

      <div class="app-content">
        <header class="app-navbar">
          <div class="app-navbar__tools">
            <button
              type="button"
              class="sidebar-toggle sidebar-toggle--navbar app-navbar__tool"
              data-sidebar-toggle
              aria-expanded="true"
              aria-label="Minimizar menu lateral"
              title="Minimizar menu lateral"
            >
              <span class="sidebar-toggle__icon" data-sidebar-toggle-icon aria-hidden="true">&#9776;</span>
            </button>
          </div>

          <div class="app-navbar__right">
            <div class="navbar-user-badge">
              <strong><%= current_user&.name %></strong>
              <span><%= law_firm_name %></span>
            </div>

            <details class="navbar-notifications">
              <summary class="app-navbar__tool" aria-label="Notificações" title="Notificações">
                <span aria-hidden="true">&#128276;</span>
                <% if @navbar_notification_total.to_i.positive? %>
                  <span class="navbar-notifications__badge"><%= @navbar_notification_total %></span>
                <% end %>
              </summary>

              <div class="navbar-notifications__panel">
                <h4>Notificações</h4>

                <div class="navbar-notifications__group">
                  <p class="navbar-notifications__title">Prazos</p>
                  <% if @navbar_deadlines.present? %>
                    <% @navbar_deadlines.each do |deadline| %>
                      <div class="navbar-notifications__item">
                        <%= link_to deadline_path(deadline), class: "navbar-notifications__item-link" do %>
                          <strong><%= deadline.title %></strong>
                          <span><%= deadline.legal_case.internal_number %> - <%= deadline.legal_case.client.full_name %> - <%= l(deadline.due_date) %></span>
                        <% end %>
                        <div class="navbar-notifications__deadline-actions">
                          <%= button_to "Cumprido", quick_update_deadline_path(deadline, action_kind: "completed"), method: :patch, class: "btn btn-secondary btn-xs", form: { class: "inline-form" } %>
                          <%= button_to "Suspenso", quick_update_deadline_path(deadline, action_kind: "suspended"), method: :patch, class: "btn btn-secondary btn-xs", form: { class: "inline-form" } %>
                          <button type="button" class="btn btn-secondary btn-xs" data-extend-toggle data-extend-target="extend-deadline-<%= deadline.id %>">
                            Prorrogado
                          </button>
                        </div>

                        <div id="extend-deadline-<%= deadline.id %>" class="navbar-notifications__extend-form" hidden>
                          <%= form_with url: quick_update_deadline_path(deadline), method: :patch, class: "navbar-notifications__extend-inline", local: true do %>
                            <%= hidden_field_tag :action_kind, "extended" %>
                            <%= date_field_tag :extended_to, deadline.due_date, required: true %>
                            <%= submit_tag "Salvar", class: "btn btn-secondary btn-xs" %>
                          <% end %>
                        </div>

                        <% if deadline.respond_to?(:extended_at) && deadline.status_extended? && deadline.extended_at.present? %>
                          <p class="navbar-notifications__meta">
                            Prorrogado em <%= l(deadline.extended_at, format: :short) %>
                          </p>
                        <% end %>
                      </div>
                    <% end %>
                  <% else %>
                    <p class="navbar-notifications__empty">Sem prazos próximos.</p>
                  <% end %>
                </div>

                <div class="navbar-notifications__group">
                  <p class="navbar-notifications__title">Tarefas</p>
                  <% if @navbar_tasks.present? %>
                    <% @navbar_tasks.each do |task| %>
                      <div class="navbar-notifications__item">
                        <%= link_to task_path(task), class: "navbar-notifications__item-link" do %>
                          <strong><%= task.title %></strong>
                          <span><%= task.legal_case.internal_number %> - <%= l(task.due_date) %></span>
                        <% end %>
                      </div>
                    <% end %>
                  <% else %>
                    <p class="navbar-notifications__empty">Sem tarefas próximas.</p>
                  <% end %>
                </div>

                <div class="navbar-notifications__actions">
                  <%= link_to "Ver prazos", deadlines_path, class: "btn btn-secondary" %>
                  <%= link_to "Ver tarefas", tasks_path, class: "btn btn-secondary" %>
                </div>
              </div>
            </details>

            <%= link_to logout_path, class: "app-navbar__logout", title: "Sair da conta", data: { turbo_method: :delete, turbo_confirm: "Deseja sair da conta?" } do %>
              <span class="app-navbar__logout-icon" aria-hidden="true">&#10162;</span>
              <span class="app-navbar__logout-label">Sair</span>
            <% end %>
          </div>
        </header>

        <main class="app-main">
          <header class="topbar">
            <div>
              <p class="topbar-kicker">Plataforma operacional</p>
              <h2><%= content_for?(:title) ? content_for(:title) : "Painel Geral" %></h2>
            </div>

            <% if content_for?(:topbar_actions) %>
              <div class="topbar-actions">
                <%= yield :topbar_actions %>
              </div>
            <% end %>
          </header>

          <% flash.each do |type, message| %>
            <div class="flash <%= type %>"><%= message %></div>
          <% end %>

          <section class="content-surface">
            <%= yield %>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
