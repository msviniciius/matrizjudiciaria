<%= form_with model: [ :office_setting, user ], class: "app-form" do |form| %>
  <% if user.errors.any? %>
    <div class="form-errors">
      <h2>Foram encontrados <%= pluralize(user.errors.count, "erro", "erros") %>:</h2>
      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="form-section">
    <h3>Dados do Usuário</h3>
    <div class="form-grid">
      <div>
        <%= form.label :name, "Nome" %>
        <%= form.text_field :name, required: true %>
      </div>

      <div>
        <%= form.label :email, "E-mail" %>
        <%= form.email_field :email, required: true %>
      </div>

      <div>
        <%= form.label :role, "Tipo de usuário" %>
        <%= form.select :role, User::ROLE_LABELS.map { |value, label| [label, value] } %>
      </div>

      <div class="field-full">
        <div class="unit-access-panel">
          <div class="unit-access-panel__head">
            <div>
              <%= form.label :unit_ids, "Unidades de acesso" %>
              <p>Defina em quais unidades este usuário poderá consultar e operar.</p>
            </div>
            <span class="unit-checklist-toolbar__count" data-unit-count>0 selecionadas</span>
          </div>
          <div class="unit-checklist-toolbar__actions">
            <button type="button" class="btn btn-secondary btn-xs" data-unit-select-all>Marcar todas</button>
            <button type="button" class="btn btn-secondary btn-xs" data-unit-clear>Limpar</button>
          </div>
          <div class="unit-access-matrix">
            <span class="unit-access-matrix__icon" aria-hidden="true">⌂</span>
            <div>
              <label class="unit-access-matrix__label" for="user_matrix_access">
                <%= hidden_field_tag "user[matrix_access]", "0" %>
                <%= check_box_tag "user[matrix_access]", "1", user.matrix_access?, id: "user_matrix_access" %>
                <span><strong><%= current_office.name %> (Matriz)</strong><small>Acesso operacional à matriz</small></span>
              </label>
            </div>
          </div>
          <div class="unit-checklist" data-unit-checklist>
            <% if current_office.units.ordered.any? %>
              <% current_office.units.ordered.each do |unit| %>
                <label class="unit-checklist__item" data-unit-item>
                  <%= check_box_tag "user[unit_ids][]", unit.id, user.unit_ids.include?(unit.id), id: "user_unit_ids_#{unit.id}" %>
                  <span><%= unit.name %></span>
                </label>
              <% end %>
            <% else %>
              <p class="unit-checklist__empty">Nenhuma unidade cadastrada para este escritório.</p>
            <% end %>
          </div>
        </div>
        <%= hidden_field_tag "user[unit_ids][]", "" %>
      </div>

      <div class="field-checkbox field-full">
        <label class="checkbox-field">
          <%= form.check_box :active %>
          <span>Usuário ativo</span>
        </label>
      </div>

      <div class="office-user-password-field">
        <%= form.label :password, user.persisted? ? "Nova senha (opcional)" : "Senha" %>
        <div class="password-field">
          <%= form.password_field :password, id: "office_user_password", autocomplete: "new-password" %>
          <button
            type="button"
            class="password-field__toggle"
            data-password-toggle
            data-password-target="office_user_password"
            aria-label="Mostrar senha"
            title="Mostrar senha"
          >
            <span data-password-icon aria-hidden="true">&#128065;</span>
          </button>
        </div>
      </div>

      <div class="office-user-password-field">
        <%= form.label :password_confirmation, user.persisted? ? "Confirmar nova senha" : "Confirmar senha" %>
        <div class="password-field">
          <%= form.password_field :password_confirmation, id: "office_user_password_confirmation", autocomplete: "new-password" %>
          <button
            type="button"
            class="password-field__toggle"
            data-password-toggle
            data-password-target="office_user_password_confirmation"
            aria-label="Mostrar confirmação de senha"
            title="Mostrar confirmação de senha"
          >
            <span data-password-icon aria-hidden="true">&#128065;</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <%= link_to "Voltar", office_setting_users_path, class: "btn btn-secondary" %>
    <%= form.submit user.persisted? ? "Salvar usuário" : "Cadastrar usuário", class: "btn btn-primary" %>
  </div>
<% end %>
