<% content_for :title, "Usuários do Escritório" %>

<% content_for :topbar_actions do %>
  <%= link_to "Novo usuário", new_office_setting_user_path, class: "btn btn-primary" %>
<% end %>

<section class="aurora-admin-listing">
<div class="table-wrap office-users-table">
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>E-mail</th>
        <th>Tipo</th>
        <th>Lotação</th>
        <th>Status</th>
        <th>Último acesso</th>
        <th class="actions-col">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if @users.any? %>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td><%= user.role_label %></td>
            <td>
              <div class="user-locations">
                <% if user.matrix_access? %>
                  <span class="user-location">Matriz</span>
                <% end %>
                <% user.units.ordered.each do |unit| %>
                  <span class="user-location"><%= unit.name %></span>
                <% end %>
                <% if !user.matrix_access? && user.units.empty? %>
                  <span class="user-location user-location--empty">Sem lotação</span>
                <% end %>
              </div>
            </td>
            <td><%= user.active? ? "Ativo" : "Inativo" %></td>
            <td><%= user.last_sign_in_at.present? ? l(user.last_sign_in_at, format: :short) : "-" %></td>
            <td class="table-actions office-users-actions">
              <%= link_to edit_office_setting_user_path(user), class: "btn btn-secondary btn-icon", aria: { label: "Editar usuário" }, title: "Editar usuário" do %>
                <span aria-hidden="true">&#9998;</span>
              <% end %>
              <% unless user == current_user %>
                <%= button_to office_setting_user_path(user), method: :delete, class: "btn btn-secondary btn-icon", data: { turbo_confirm: "Excluir este usuário?" }, aria: { label: "Excluir usuário" }, title: "Excluir usuário" do %>
                  <span aria-hidden="true">&#128465;</span>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="7" class="table-empty-state">Nenhum usuário cadastrado para este escritório.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
</section>
