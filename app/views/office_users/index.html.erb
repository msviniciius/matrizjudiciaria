<% content_for :title, "Usuários do Escritório" %>

<% content_for :topbar_actions do %>
  <%= link_to "Novo usuário", new_office_setting_user_path, class: "btn btn-primary" %>
<% end %>

<div class="table-wrap office-users-table">
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>E-mail</th>
        <th>Tipo</th>
        <th>Status</th>
        <th>Último acesso</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if @users.any? %>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td><%= user.admin? ? "Administrador" : "Atendente" %></td>
            <td><%= user.active? ? "Ativo" : "Inativo" %></td>
            <td><%= user.last_sign_in_at.present? ? l(user.last_sign_in_at, format: :short) : "-" %></td>
            <td class="office-users-actions">
              <%= link_to "Editar", edit_office_setting_user_path(user), class: "btn btn-secondary" %>
              <% unless user == current_user %>
                <%= link_to "Excluir", office_setting_user_path(user), class: "btn btn-secondary", data: { turbo_method: :delete, turbo_confirm: "Excluir este usuário?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" class="table-empty-state">Nenhum usuário cadastrado para este escritório.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
