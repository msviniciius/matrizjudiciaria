<% content_for :title, "Tipos de Andamento" %>

<% content_for :topbar_actions do %>
  <%= link_to "Novo tipo", new_movement_type_path, class: "btn btn-primary" %>
<% end %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Código</th>
        <th>Ativo</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if @movement_types.any? %>
        <% @movement_types.each do |movement_type| %>
          <tr>
            <td><%= movement_type.name %></td>
            <td><%= movement_type.code %></td>
            <td><%= movement_type.active ? "Sim" : "Não" %></td>
            <td>
              <div class="table-actions">
                <%= link_to "Editar", edit_movement_type_path(movement_type), class: "btn btn-secondary" %>
                <%= button_to "Excluir", movement_type_path(movement_type), method: :delete, class: "btn btn-danger", form: { class: "table-action-form", data: { turbo_confirm: "Confirma a exclusão?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="4" class="table-empty-state">Nenhum tipo de andamento cadastrado.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
